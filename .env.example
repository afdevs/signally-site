# ---------------------------------------------------------------------------
# Envoi du formulaire de contact vers contacts@signally.io
# ---------------------------------------------------------------------------
# Deux façons de configurer, par ordre de priorité.

# ---- 1. MAILER_DSN (recommandé) -------------------------------------------
# Syntaxe Symfony Mailer, identique à celle utilisée par l'application
# Signally : une seule valeur à maintenir entre les deux environnements.
#
#   sendgrid://<clé_api>@default        relais SMTP SendGrid
#   smtp://<user>:<pass>@<hôte>:<port>  SMTP générique (STARTTLS)
#   smtps://<user>:<pass>@<hôte>:465    SMTP générique (TLS implicite)
#   ethereal://                         compte de test, aucun envoi réel
#
# Note : les transports « API » de Symfony (sendgrid+api://) ne sont pas
# pris en charge — ce projet n'envoie qu'en SMTP.
MAILER_DSN=

# ---- 2. Variables SMTP explicites (repli) ---------------------------------
# Ignorées si MAILER_DSN est renseigné.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# Expéditeur et destinataire
# ---------------------------------------------------------------------------
# MAIL_FROM doit être une identité d'expéditeur vérifiée chez votre
# fournisseur (Verified Sender ou domaine authentifié), sans quoi l'envoi
# est rejeté.
MAIL_FROM="Signally <no-reply@signally.io>"
MAIL_TO=contacts@signally.io

# ---------------------------------------------------------------------------
# Assistant du site public
# ---------------------------------------------------------------------------
# Cinq variables, toutes désactivées par défaut. Le chat reste masqué tant que
# PUBLIC_SITE_CHAT_ENABLED n'est pas explicitement mis à "true" au build.

# URL de la passerelle SITE côté API (chatbot-workstream-a). Sans elle, le
# widget ne peut joindre aucun backend et les requêtes échouent.
SITE_CHAT_API_URL=https://api.signally.io

# Secret partagé avec l'API pour authentifier les requêtes du site vers la
# passerelle SITE. Absent, l'API refuse les appels : ne jamais y mettre une
# valeur, même de test.
SITE_CHAT_SHARED_SECRET=

# Clé publique du widget Cloudflare Turnstile. Sous Astro, seule une variable
# préfixée PUBLIC_ est exposée au navigateur : cette clé le doit, car elle
# s'affiche côté client pour générer le défi anti-bot. Absente, le widget ne
# peut pas s'initialiser.
PUBLIC_TURNSTILE_SITE_KEY=

# Secret de vérification Turnstile, utilisé uniquement côté serveur pour
# valider le jeton renvoyé par le widget. Sans préfixe PUBLIC_ précisément
# parce qu'il ne doit jamais atteindre le navigateur. Absent, la vérification
# échoue fermé (aucune requête n'est acceptée).
TURNSTILE_SECRET_KEY=

# Bascule d'activation du chat, lue via import.meta.env et donc figée au
# moment du build : changer cette valeur impose un nouveau build (un
# déploiement via scripts/deploy.sh suffit), pas seulement un redémarrage. La
# comparaison est une égalité stricte avec la chaîne "true" ; toute valeur
# absente ou différente laisse le chat désactivé.
PUBLIC_SITE_CHAT_ENABLED=false
