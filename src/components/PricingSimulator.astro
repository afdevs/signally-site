---
import { simulate, eur, DEFAULTS } from '../lib/pricing';
import { getDictionary } from '../i18n';
import { LOCALE_META, localeFromPath, type Locale } from '../i18n/config';

/**
 * Version compacte (un seul curseur) du simulateur, utilisée dans le
 * bloc Tarifs de la page d'accueil. La page /tarifs utilise
 * PricingSimulatorFull, qui partage le même contrat DOM et le même
 * script client.
 */

interface Props {
  /** Déduite de l'URL par défaut : les pages n'ont pas à la passer. */
  locale?: Locale;
}

const { locale = localeFromPath(Astro.url.pathname) } = Astro.props;
const t = getDictionary(locale).pricing;
const intlLocale = LOCALE_META[locale].intlLocale;
const money = (value: number, digits = 2) => eur(value, digits, intlLocale);

// Rendu serveur : les montants sont corrects sans JavaScript.
const s = simulate({ users: DEFAULTS.users });
---

<div class="sim" data-sim data-sim-locale={intlLocale}>
  {/* Le nombre d'utilisateurs est centré et à la taille du montant :
      les deux chiffres du bloc se lisent alors comme une paire. */}
  <div class="sim__row">
    <label class="sim__label" for="sim-users-compact">{t.compact.label}</label>
    <span class="sim__value" data-sim-label="users">{s.users}</span>
  </div>

  <input
    type="range"
    id="sim-users-compact"
    min="1"
    max="2000"
    step="1"
    value={s.users}
    data-sim-input="users"
    aria-describedby="sim-compact-result"
  />

  <div class="sim__scale" aria-hidden="true">
    <span>1</span><span>500</span><span>1000</span><span>2000</span>
  </div>

  <div class="sim__result" id="sim-compact-result">
    <div>
      <div class="sim__amount" data-sim-out="monthly">{money(s.monthly)}</div>
      <div class="sim__caption">{t.compact.perMonth}</div>
    </div>
    <div>
      <div class="sim__rate" data-sim-out="rate">{money(s.rate)}</div>
      <div class="sim__caption">{t.compact.perUser}</div>
    </div>
  </div>
</div>

<style>
  .sim {
    border: 1px solid var(--line);
    border-radius: var(--r-2xl);
    padding: 30px;
    background: var(--soft);
  }

  .sim__row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-bottom: 16px;
    text-align: center;
  }

  .sim__label { font-size: 15px; font-weight: 700; }

  .sim__value {
    font-family: var(--font-mono);
    font-size: 38px;
    font-weight: 700;
    line-height: 1.05;
  }

  .sim input[type='range'] {
    width: 100%;
    accent-color: var(--brand);
    height: 6px;
    cursor: pointer;
  }

  .sim__scale {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    margin-top: 6px;
  }

  .sim__result {
    display: flex;
    align-items: flex-end;
    gap: 28px;
    flex-wrap: wrap;
    margin-top: 26px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .sim__amount {
    font-family: var(--font-mono);
    font-size: 38px;
    font-weight: 700;
    line-height: 1;
  }

  .sim__rate {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 700;
    color: var(--link-hover);
  }

  .sim__caption { font-size: 13px; color: var(--sec); margin-top: 6px; }

  @media (max-width: 560px) {
    .sim { padding: 22px; }
    .sim__amount, .sim__value { font-size: 30px; }
  }
</style>

<script>
  import { initSimulators } from '../lib/sim-client';
  initSimulators();
</script>
