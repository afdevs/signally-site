---
/**
 * Section « L'outil, en trois écrans ».
 *
 * Les trois captures ne sont pas fournies dans le prototype (les
 * <image-slot> y sont vides). Chaque onglet tente de charger
 * /screenshots/<id>.png ; si le fichier est absent, l'image se retire
 * et le cartouche décrit la capture attendue. Déposer les trois
 * fichiers suffit à les afficher, sans toucher au code.
 */

import { getDictionary } from '../i18n';
import { localeFromPath, type Locale } from '../i18n/config';

interface Props {
  /** Déduite de l'URL par défaut : les pages n'ont pas à la passer. */
  locale?: Locale;
}

const { locale = localeFromPath(Astro.url.pathname) } = Astro.props;
const t = getDictionary(locale).home.app;

/** Les identifiants sont techniques : ils nomment les fichiers de capture. */
const TAB_IDS = ['editor', 'teams', 'campaigns'] as const;

const TABS = TAB_IDS.map((id, i) => ({ id, ...t.tabs[i] }));
---

<section class="section section--soft">
  <div class="container">
    <div class="apptabs__head">
      <h2 class="apptabs__title">{t.title}</h2>
      <div class="apptabs__tabs" role="tablist" aria-label={t.tablistAria}>
        {TABS.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            aria-controls={`panel-${tab.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="apptabs__tab"
            data-tab={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </div>
    </div>

    <div class="apptabs__frame">
      <div class="apptabs__chrome">
        <span class="apptabs__dot"></span>
        <span class="apptabs__dot"></span>
        <span class="apptabs__dot"></span>
        <span class="apptabs__url">app.signally.io</span>
      </div>
      <div class="apptabs__stage">
        {TABS.map((tab, i) => (
          <div
            role="tabpanel"
            id={`panel-${tab.id}`}
            aria-labelledby={`tab-${tab.id}`}
            class="apptabs__panel"
            data-panel={tab.id}
            hidden={i !== 0}
          >
            <img
              src={`/screenshots/${tab.id}.png`}
              alt={tab.alt}
              class="apptabs__shot"
              loading="lazy"
              decoding="async"
              onerror="this.remove()"
            />
            <div class="apptabs__ph">
              <span class="apptabs__ph-badge">{t.placeholderBadge}</span>
              <p class="apptabs__ph-text">{tab.placeholder}</p>
              <code class="apptabs__ph-path">public/screenshots/{tab.id}.png</code>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="apptabs__notes">
      {t.notes.map((note) => (
        <div>
          <div class="apptabs__note-title">{note.title}</div>
          <p class="apptabs__note-text">{note.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .apptabs__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .apptabs__title {
    font-size: 38px;
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 800;
    margin: 0;
    max-width: 560px;
  }

  .apptabs__tabs { display: flex; gap: 8px; }

  .apptabs__tab {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    padding: 11px 18px;
    border-radius: var(--r-pill);
    cursor: pointer;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--sec);
    transition: all 0.15s ease;
  }
  .apptabs__tab:hover { border-color: var(--ink); color: var(--ink); }
  .apptabs__tab[aria-selected='true'] {
    background: var(--ink);
    color: var(--white);
    border-color: var(--ink);
  }

  .apptabs__frame {
    border: 1px solid var(--line);
    border-radius: var(--r-3xl);
    overflow: hidden;
    background: var(--soft);
  }

  .apptabs__chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--line);
    background: var(--white);
  }

  .apptabs__dot {
    width: 9px;
    height: 9px;
    border-radius: var(--r-pill);
    background: var(--line);
  }

  .apptabs__url {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    margin-left: 10px;
  }

  .apptabs__stage {
    height: 520px;
    position: relative;
  }

  .apptabs__panel {
    position: absolute;
    inset: 0;
  }
  .apptabs__panel[hidden] { display: none; }

  .apptabs__shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    /* Au-dessus du cartouche : dès que l'image charge, elle le masque. */
    z-index: 1;
  }

  .apptabs__ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
    padding: 32px;
    background:
      repeating-linear-gradient(
        135deg,
        var(--soft) 0 14px,
        #f1efe8 14px 28px
      );
  }

  .apptabs__ph-badge {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--ink);
    background: var(--brand);
    padding: 6px 12px;
    border-radius: var(--r-sm);
  }

  .apptabs__ph-text {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink-2);
    margin: 0;
    max-width: 420px;
  }

  .apptabs__ph-path {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    background: var(--white);
    border: 1px solid var(--line);
    padding: 6px 10px;
    border-radius: var(--r-sm);
  }

  .apptabs__notes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 28px;
  }

  .apptabs__note-title { font-weight: 800; font-size: 16px; margin-bottom: 5px; }
  .apptabs__note-text {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--sec);
    margin: 0;
  }

  @media (max-width: 1024px) {
    .apptabs__title { font-size: 30px; }
    .apptabs__stage { height: 420px; }
    .apptabs__notes { grid-template-columns: 1fr; gap: 18px; }
  }

  @media (max-width: 560px) {
    .apptabs__title { font-size: 25px; }
    .apptabs__head { gap: 20px; }
    .apptabs__tabs { width: 100%; }
    .apptabs__tab { flex: 1; padding: 11px 8px; font-size: 13.5px; }
    .apptabs__stage { height: 300px; }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));

  function select(id: string) {
    for (const tab of tabs) {
      const on = tab.dataset.tab === id;
      tab.setAttribute('aria-selected', String(on));
      tab.tabIndex = on ? 0 : -1;
    }
    for (const panel of panels) {
      panel.hidden = panel.dataset.panel !== id;
    }
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => select(tab.dataset.tab!));

    // Navigation clavier attendue pour un motif tablist.
    tab.addEventListener('keydown', (event) => {
      const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (!delta) return;
      event.preventDefault();
      const next = tabs[(index + delta + tabs.length) % tabs.length];
      select(next.dataset.tab!);
      next.focus();
    });
  });
</script>
