---
import { clusterOfPillar } from '../data/clusters';
import { articlesInCluster } from '../lib/blog';
import { getDictionary } from '../i18n';
import { hasBlog, localeFromPath, type Locale } from '../i18n/config';
import type { PageKey } from '../i18n/routes';

/**
 * Liste des articles satellites d'une page pilier.
 *
 * Règle de maillage interne définie par le prototype (page « Plan
 * éditorial SEO ») : « Chaque page pilier liste ses articles satellites
 * en pied de page. »
 */

interface Props {
  /** Clé de la page pilier, ex. « features ». */
  pillar: PageKey;
  title?: string;
  /** Déduite de l'URL par défaut : les pages n'ont pas à la passer. */
  locale?: Locale;
}

const { pillar, locale = localeFromPath(Astro.url.pathname) } = Astro.props;
const { common } = getDictionary(locale);
const { title = common.sections.satellites } = Astro.props;

/**
 * Sans blog dans la langue de la page, la section disparaît plutôt que
 * de renvoyer un lecteur anglais ou espagnol vers des articles qu'il ne
 * peut pas lire.
 */
const cluster = clusterOfPillar(pillar);
const articles = hasBlog(locale) && cluster ? await articlesInCluster(locale, cluster) : [];
---

{articles.length > 0 && (
  <section class="sat">
    <div class="container">
      <h2 class="sat__title">{title}</h2>
      <ul class="sat__list">
        {articles.map((a) => (
          <li><a href={a.href}>{a.title}</a></li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .sat {
    background: var(--soft);
    border-top: 1px solid var(--line);
    padding-block: 64px;
  }

  .sat__title {
    font-size: 22px;
    font-weight: 800;
    margin: 0 0 18px;
  }

  .sat__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 32px;
  }

  .sat__list a {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .sat__list a:hover { color: var(--link-hover); border-bottom-color: currentColor; }

  @media (max-width: 768px) {
    .sat { padding-block: 48px; }
    .sat__list { grid-template-columns: 1fr; }
  }
</style>
