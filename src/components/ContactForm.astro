---
import { ENVIRONMENTS } from '../lib/contact-schema';
import { CONTACT_EMAIL } from '../data/nav';
import { getDictionary } from '../i18n';
import { localeFromPath, type Locale } from '../i18n/config';

/**
 * Formulaire de demande de démonstration.
 *
 * Il a une `action` et une `method` réelles : sans JavaScript, le
 * navigateur poste normalement et l'API répond par une redirection.
 * Avec JavaScript, le script intercepte, poste en JSON et affiche les
 * erreurs champ par champ sans recharger la page.
 *
 * Un champ caché transporte la langue jusqu'à l'API, qui doit à la fois
 * renvoyer ses messages d'erreur dans cette langue et rediriger vers la
 * bonne page de contact — /es/contacto et non /contact.
 */

interface Props {
  /** Déduite de l'URL par défaut : les pages n'ont pas à la passer. */
  locale?: Locale;
}

const { locale = localeFromPath(Astro.url.pathname) } = Astro.props;
const t = getDictionary(locale).contact.form;

const { searchParams } = Astro.url;
const sent = searchParams.get('envoye') === '1';
const errorCode = searchParams.get('erreur');

const ALERTS: Record<string, string> = {
  validation: t.alerts.validation,
  frequence: t.alerts.frequence,
  envoi: `${t.alerts.envoi} ${CONTACT_EMAIL}.`,
  format: t.alerts.format,
};
const errorMessage = errorCode ? (ALERTS[errorCode] ?? ALERTS.envoi) : null;

/** Les valeurs restent en français : seul le libellé affiché est traduit. */
const environmentOptions = ENVIRONMENTS.map((value, index) => ({
  value,
  label: t.environments[index],
}));
---

<div class="form-card">
  <h2 class="form-card__title">{t.title}</h2>

  <!-- Panneau de succès : affiché après une soumission sans JavaScript,
       et réutilisé par le script après une réponse JSON positive. -->
  <div class="alert alert--ok" data-success hidden={!sent} role="status">
    <strong>{t.successTitle}</strong>
    {t.successText}
  </div>

  <div class="alert alert--error" data-error hidden={!errorMessage} role="alert">
    {errorMessage}
  </div>

  <form
    method="POST"
    action="/api/contact"
    novalidate
    data-contact-form
    data-submitting-label={t.submitting}
    data-error-validation={t.alerts.validation}
    data-error-send={`${t.alerts.envoi} ${CONTACT_EMAIL}.`}
    data-error-network={`${t.alerts.network} ${CONTACT_EMAIL}.`}
    hidden={sent}
  >
    <div class="fields">
      <div class="field">
        <label for="name">{t.fields.name.label}</label>
        <input type="text" id="name" name="name" placeholder={t.fields.name.placeholder} autocomplete="name" required />
        <p class="field__error" data-error-for="name" hidden></p>
      </div>

      <div class="field">
        <label for="email">{t.fields.email.label}</label>
        <input type="email" id="email" name="email" placeholder={t.fields.email.placeholder} autocomplete="email" required />
        <p class="field__error" data-error-for="email" hidden></p>
      </div>

      <div class="field">
        <label for="company">{t.fields.company.label}</label>
        <input type="text" id="company" name="company" placeholder={t.fields.company.placeholder} autocomplete="organization" required />
        <p class="field__error" data-error-for="company" hidden></p>
      </div>

      <div class="field">
        <label for="headcount">{t.fields.headcount.label}</label>
        <input type="text" id="headcount" name="headcount" placeholder={t.fields.headcount.placeholder} inputmode="numeric" />
        <p class="field__error" data-error-for="headcount" hidden></p>
      </div>

      <div class="field field--full">
        <label for="environment">{t.fields.environment.label}</label>
        <select id="environment" name="environment" required>
          {environmentOptions.map((env) => <option value={env.value}>{env.label}</option>)}
        </select>
        <p class="field__error" data-error-for="environment" hidden></p>
      </div>

      <div class="field field--full">
        <label for="message">{t.fields.message.label}</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          placeholder={t.fields.message.placeholder}
          required></textarea>
        <p class="field__error" data-error-for="message" hidden></p>
      </div>
    </div>

    {/* Pot de miel : hors flux, invisible, ignoré par la saisie clavier. */}
    <div class="honeypot" aria-hidden="true">
      <label for="website">{t.honeypot}</label>
      <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="ts" data-ts value="0" />
    <input type="hidden" name="locale" value={locale} />

    <button type="submit" class="form-card__submit" data-submit>{t.submit}</button>

    <p class="form-card__legal">{t.legal}</p>
  </form>
</div>

<style>
  .form-card {
    border: 1px solid var(--line);
    border-radius: var(--r-2xl);
    padding: 34px;
  }

  .form-card__title { font-size: 24px; font-weight: 800; margin: 0 0 24px; }

  .alert {
    border-radius: var(--r-md);
    padding: 14px 16px;
    font-size: 14.5px;
    line-height: 1.55;
    margin-bottom: 20px;
  }
  .alert[hidden] { display: none; }

  .alert--ok {
    background: var(--brand-surface);
    border: 1px solid var(--brand);
    color: var(--ink);
  }

  .alert--error {
    background: #fdf0f0;
    border: 1px solid #e8b4b4;
    color: #8a2b2b;
  }

  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .field--full { grid-column: 1 / -1; }

  .field label {
    display: block;
    font-size: 13.5px;
    font-weight: 700;
    margin-bottom: 7px;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    font-family: var(--font-sans);
    font-size: 14.5px;
    color: var(--ink);
    background: var(--white);
    transition: border-color 0.15s ease;
  }

  .field input:hover,
  .field select:hover,
  .field textarea:hover { border-color: var(--border-strong, #a3a39e); }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--brand-stronger);
    outline: 2px solid var(--brand);
    outline-offset: 1px;
  }

  .field textarea { resize: vertical; min-height: 96px; }

  .field input[aria-invalid='true'],
  .field select[aria-invalid='true'],
  .field textarea[aria-invalid='true'] { border-color: #d64545; }

  .field__error {
    font-size: 13px;
    color: #b03636;
    margin: 6px 0 0;
  }
  .field__error[hidden] { display: none; }

  /* Hors écran plutôt que display:none — certains robots ignorent les
     champs masqués par CSS classique mais remplissent ceux-ci. */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-card__submit {
    margin-top: 22px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    padding: 14px 24px;
    border-radius: 11px;
    background: var(--brand);
    color: var(--ink);
    border: 0;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .form-card__submit:hover:not(:disabled) { background: var(--brand-strong); }
  .form-card__submit:disabled { opacity: 0.6; cursor: progress; }

  .form-card__legal {
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--muted);
    margin: 14px 0 0;
  }

  @media (max-width: 560px) {
    .form-card { padding: 24px; }
    .fields { grid-template-columns: 1fr; }
    .form-card__submit { width: 100%; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const successBox = document.querySelector<HTMLElement>('[data-success]')!;
    const errorBox = document.querySelector<HTMLElement>('[data-error]')!;
    const tsField = form.querySelector<HTMLInputElement>('[data-ts]')!;

    // Horodatage d'affichage : sert au contrôle « soumis trop vite ».
    tsField.value = String(Date.now());

    const clearErrors = () => {
      errorBox.hidden = true;
      for (const el of form.querySelectorAll<HTMLElement>('[data-error-for]')) {
        el.hidden = true;
        el.textContent = '';
      }
      for (const el of form.querySelectorAll('[aria-invalid]')) {
        el.removeAttribute('aria-invalid');
      }
    };

    const showFieldErrors = (errors: Record<string, string>) => {
      let first: HTMLElement | null = null;
      for (const [field, message] of Object.entries(errors)) {
        const slot = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
        const input = form.querySelector<HTMLElement>(`[name="${field}"]`);
        if (slot) {
          slot.textContent = message;
          slot.hidden = false;
        }
        if (input) {
          input.setAttribute('aria-invalid', 'true');
          if (!first) first = input;
        }
      }
      first?.focus();
    };

    const showError = (message: string) => {
      errorBox.textContent = message;
      errorBox.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();

      submit.disabled = true;
      const label = submit.textContent;
      submit.textContent = form.dataset.submittingLabel!;

      const payload = Object.fromEntries(new FormData(form));

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await response.json().catch(() => ({}));

        if (response.ok && result.ok) {
          form.hidden = true;
          successBox.hidden = false;
          successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        if (result.errors) {
          showFieldErrors(result.errors);
          showError(form.dataset.errorValidation!);
        } else {
          showError(result.error ?? form.dataset.errorSend!);
        }
      } catch {
        showError(form.dataset.errorNetwork!);
      } finally {
        submit.disabled = false;
        submit.textContent = label;
      }
    });
  }
</script>
