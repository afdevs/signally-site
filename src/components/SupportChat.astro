---
import { getDictionary } from '../i18n';
import { localeFromPath, type Locale } from '../i18n/config';
import { localizedPath, pageKeyOf, type PageKey } from '../i18n/routes';

/**
 * Widget d'assistance du site public.
 *
 * Le lanceur, le panneau, le clavier, le focus, la copie, et l'envoi vers
 * `/api/chat` et `/api/chat-feedback`.
 *
 * **La réponse du modèle ne devient jamais du HTML.** `parseAnswer` la découpe
 * en jetons et le script construit des nœuds : ce dépôt n'embarque aucun
 * assainisseur, et une sortie de modèle n'est pas du balisage de confiance.
 * Aucun puits d'injection HTML n'a sa place dans ce fichier, et la barrière de
 * la tâche le vérifie par un grep.
 *
 * Le lanceur est construit par le script, jamais par ce markup : sans
 * JavaScript un bouton de chat serait un bouton mort, et ce site se dégrade
 * proprement partout ailleurs (le formulaire de contact poste sans JS, la FAQ
 * est en `<details>`). Le panneau, lui, est rendu ici mais `hidden` avec sa
 * racine : sans JS rien n'est visible ni exposé aux technologies d'assistance.
 *
 * Le `pageKey` accompagne la question à la place du chemin localisé, pour que
 * le contexte du prompt reste stable d'une langue à l'autre.
 *
 * Turnstile est la seule requête tierce du site, et elle n'est demandée qu'à
 * l'ouverture du panneau. Ce chargement paresseux et conditionnel est un
 * **choix de posture, pas une optimisation** : un visiteur qui n'ouvre pas le
 * chat ne doit émettre aucune requête vers Cloudflare. Le détail est en tête
 * de la section « Turnstile » du script.
 */

interface Props {
  /** Déduite de l'URL par défaut : les pages n'ont pas à la passer. */
  locale?: Locale;
  /** Clé canonique de la page courante, si l'appelant l'a déjà calculée. */
  pageKey?: PageKey;
}

const {
  locale = localeFromPath(Astro.url.pathname),
  pageKey = pageKeyOf(Astro.url.pathname),
} = Astro.props;

const common = getDictionary(locale).common;
const t = common.supportChat;

/**
 * La copie que seul le script utilise voyage en `data-*` : le dictionnaire
 * n'est pas accessible depuis un script client, et dupliquer une chaîne
 * traduite dans le script serait une seconde source de vérité.
 *
 * `errors.generic` fait exception au principe « le message d'erreur arrive
 * déjà traduit » : il ne sert que lorsque la passerelle n'a rien pu dire du
 * tout (panne réseau, corps illisible). Ce n'est pas une table de
 * correspondance, c'est le seul cas où il n'y a aucun message à afficher.
 */
const contactPath = localizedPath('contact', locale);
const contactLabel = common.pages.contact.label;

/**
 * Le préfixe `PUBLIC_` est ce qui autorise Astro à exposer la valeur au
 * navigateur — c'est bien une clé de site, publique par nature. Le secret de
 * vérification, lui, ne vit que dans `src/lib/turnstile.ts` côté serveur et
 * n'a rien à faire dans ce fichier.
 *
 * Vide ou absente, rien n'est chargé et aucun jeton n'est envoyé : la
 * passerelle accepte, parce que son propre secret est absent lui aussi. C'est
 * ainsi que la fonction se livre avant les clés et se durcit ensuite par la
 * seule configuration.
 */
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<div
  class="support-chat"
  data-support-chat
  data-locale={locale}
  data-page-key={pageKey}
  data-launcher-label={t.launcher}
  data-unanswered-text={t.unanswered}
  data-contact-path={contactPath}
  data-contact-label={contactLabel}
  data-retry-label={t.actions.retry}
  data-up-label={t.feedback.up}
  data-down-label={t.feedback.down}
  data-thanks-label={t.feedback.thanks}
  data-generic-error={t.errors.generic}
  data-turnstile-site-key={turnstileSiteKey || undefined}
  hidden
>
  <div
    class="support-chat__panel"
    id="support-chat-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="support-chat-title"
    data-panel
    hidden
  >
    <div class="support-chat__header">
      <h2 class="support-chat__title" id="support-chat-title">{t.title}</h2>
    </div>

    <div class="support-chat__log" data-log>
      <ul class="support-chat__starters" data-starters>
        {t.starters.map((question) => (
          <li>
            <button type="button" class="support-chat__starter" data-starter>{question}</button>
          </li>
        ))}
      </ul>

      <div class="support-chat__turns" data-turns></div>

      {/* Région polie dévoilée pendant l'attente. Elle ne contient que des
          points décoratifs : le dictionnaire n'a pas de chaîne « envoi en
          cours », et en inventer une ici est interdit. */}
      <p class="support-chat__pending" data-pending aria-live="polite" hidden>
        <span class="support-chat__dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </p>
    </div>

    {/* Conteneur du rendu explicite. Absent sans clé : sans lui, le script ne
        demande rien à Cloudflare. Aucun attribut `cf-*` ici — le rendu
        automatique s'exécuterait au chargement du script et viderait de son
        sens le chargement paresseux. */}
    {turnstileSiteKey && <div class="support-chat__turnstile" data-turnstile></div>}

    <form class="support-chat__form" data-form>
      <textarea
        class="support-chat__input"
        data-input
        rows="2"
        maxlength="2000"
        placeholder={t.placeholder}
        aria-label={t.placeholder}></textarea>
      <button type="submit" class="btn btn--brand btn--sm support-chat__send" data-send>
        {t.send}
      </button>
    </form>

    <p class="support-chat__footer">{t.footer}</p>
  </div>
</div>

<style>
  /* 60 : au-dessus des mega-menus de l'en-tête (50), sous le lien
     d'évitement (200) qui doit rester atteignable au premier Tab. */
  .support-chat {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }
  .support-chat[hidden] { display: none; }

  /* Largeur relative : à 360 px le panneau se réduit au lieu de déborder. */
  .support-chat__panel {
    display: flex;
    flex-direction: column;
    width: min(384px, calc(100vw - 32px));
    max-height: min(560px, calc(100vh - 132px));
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-menu);
    overflow: hidden;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.16s ease, transform 0.16s ease;
  }
  .support-chat__panel[hidden] { display: none; }
  .support-chat__panel.is-open { opacity: 1; transform: none; }

  .support-chat__header {
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }

  .support-chat__title {
    margin: 0;
    font-size: 15px;
    font-weight: 800;
    color: var(--ink);
  }

  .support-chat__log {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
  }

  .support-chat__starters {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .support-chat__starters[hidden] { display: none; }

  .support-chat__starter {
    width: 100%;
    text-align: left;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 10px 12px;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .support-chat__starter:hover {
    background: var(--soft);
    border-color: var(--brand-stronger);
  }

  .support-chat__turns {
    display: grid;
    gap: 10px;
  }
  .support-chat__turns:not(:empty) { margin-top: 4px; }

  .support-chat__pending { margin: 12px 0 0; }
  .support-chat__pending[hidden] { display: none; }

  .support-chat__dots {
    display: inline-flex;
    gap: 4px;
    align-items: center;
  }
  .support-chat__dots span {
    width: 5px;
    height: 5px;
    border-radius: var(--r-pill);
    background: var(--muted);
    animation: supportChatDot 1s ease-in-out infinite;
  }
  .support-chat__dots span:nth-child(2) { animation-delay: 0.15s; }
  .support-chat__dots span:nth-child(3) { animation-delay: 0.3s; }

  /* Neutralisé par le bloc `prefers-reduced-motion` global de tokens.css. */
  @keyframes supportChatDot {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  /* En mode géré `interaction-only`, Cloudflare rend bien un enfant mais le
     garde masqué tant qu'il ne réclame pas de défi. La gouttière verticale est
     donc portée par l'enfant, pas par le conteneur : un enfant masqué ne rend
     pas sa marge, et le conteneur reste de hauteur nulle tant qu'il n'y a rien
     à montrer au-dessus du champ de saisie. */
  .support-chat__turnstile { padding: 0 16px; }
  .support-chat__turnstile > * { margin-top: 12px; }

  .support-chat__form {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding: 12px 16px 0;
    border-top: 1px solid var(--line);
  }

  .support-chat__input {
    flex: 1;
    min-width: 0;
    box-sizing: border-box;
    resize: none;
    max-height: 96px;
    padding: 10px 12px;
    font-family: var(--font-sans);
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--ink);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    transition: border-color 0.15s ease;
  }
  .support-chat__input:focus { border-color: var(--brand-stronger); }

  /* `width: auto` reprend la main sur le `.btn { width: 100% }` mobile de
     global.css, qui pousserait le bouton hors du panneau à 360 px. */
  .support-chat__send {
    flex: none;
    width: auto;
    font-size: 14px;
    padding: 11px 16px;
  }
  .support-chat__send:disabled { opacity: 0.6; cursor: progress; }

  /* La mention de génération automatique est une obligation d'information :
     elle garde une taille lisible et un contraste de texte courant. */
  .support-chat__footer {
    margin: 0;
    padding: 10px 16px 14px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--sec);
  }

  /* Le lanceur et les tours naissent du script : hors de portée du
     hachage de portée d'Astro, donc déclarés en `:global`. */
  .support-chat :global(.support-chat__launcher) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--brand);
    color: var(--brand-ink);
    box-shadow: var(--shadow-menu);
    cursor: pointer;
    transition: background 0.16s ease;
  }
  .support-chat :global(.support-chat__launcher:hover) { background: var(--brand-strong); }

  .support-chat :global(.support-chat__turn) {
    margin: 0;
    max-width: 85%;
    padding: 9px 12px;
    font-size: 14.5px;
    line-height: 1.5;
    border-radius: var(--r-md);
    /* Une URL collée ne doit pas élargir le panneau, et les retours à la
       ligne saisis en Maj+Entrée doivent survivre à l'affichage. */
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .support-chat :global(.support-chat__turn--user) {
    justify-self: end;
    background: var(--brand-subtle);
    color: var(--ink);
  }

  /* Une réponse n'est pas un `<p>` mais un conteneur de blocs : le `pre-wrap`
     hérité de `.support-chat__turn` garde les retours à la ligne simples d'un
     paragraphe, et les marges des blocs sont reprises ici. */
  .support-chat :global(.support-chat__turn--bot) {
    justify-self: start;
    max-width: 100%;
    background: var(--soft);
    color: var(--ink);
  }
  .support-chat :global(.support-chat__turn--bot > *) { margin: 0; }
  .support-chat :global(.support-chat__turn--bot > * + *) { margin-top: 8px; }
  .support-chat :global(.support-chat__turn--bot ul),
  .support-chat :global(.support-chat__turn--bot ol) { padding-left: 20px; }
  .support-chat :global(.support-chat__turn--bot li + li) { margin-top: 4px; }
  .support-chat :global(.support-chat__turn--bot a) {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* La réponse, sa mention éventuelle et ses pouces forment un seul groupe :
     les pouces doivent coller à la réponse qu'ils notent, pas flotter à la
     distance des tours. */
  .support-chat :global(.support-chat__answer) {
    display: grid;
    justify-items: start;
    gap: 6px;
  }

  .support-chat :global(.support-chat__note) {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--sec);
  }
  /* Souligné : un lien ne doit pas se distinguer par la seule couleur. */
  .support-chat :global(.support-chat__note a) {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .support-chat :global(.support-chat__feedback) {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .support-chat :global(.support-chat__vote) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    color: var(--sec);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .support-chat :global(.support-chat__vote:hover:not(:disabled)) {
    color: var(--ink);
    border-color: var(--brand-stronger);
  }
  .support-chat :global(.support-chat__vote[aria-pressed='true']) {
    color: var(--ink);
    background: var(--brand-subtle);
    border-color: var(--brand-stronger);
  }
  .support-chat :global(.support-chat__vote:disabled) { cursor: default; }

  .support-chat :global(.support-chat__thanks) {
    font-size: 13px;
    color: var(--sec);
  }

  .support-chat :global(.support-chat__error) {
    display: grid;
    justify-items: start;
    gap: 8px;
    padding: 10px 12px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink);
    background: var(--soft);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .support-chat :global(.support-chat__error p) { margin: 0; }

  .support-chat :global(.support-chat__retry) {
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 6px 12px;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .support-chat :global(.support-chat__retry:hover) { border-color: var(--brand-stronger); }

  @media (max-width: 480px) {
    .support-chat__panel { max-height: min(560px, calc(100vh - 108px)); }
  }
</style>

<script>
  import { parseInline, splitBlocks, stripMarker } from '../lib/parseAnswer';

  const SVG_NS = 'http://www.w3.org/2000/svg';

  const BUBBLE_PATH =
    'M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z';

  const THUMB_UP_PATHS = [
    'M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3z',
    'M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3',
  ];

  const THUMB_DOWN_PATHS = [
    'M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3z',
    'M17 2h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17',
  ];

  /** Icônes construites en nœuds : le site n'a aucun assainisseur. */
  function icon(size: number, paths: readonly string[]): SVGElement {
    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('width', String(size));
    svg.setAttribute('height', String(size));
    svg.setAttribute('fill', 'none');
    svg.setAttribute('stroke', 'currentColor');
    svg.setAttribute('stroke-width', '2');
    svg.setAttribute('stroke-linecap', 'round');
    svg.setAttribute('stroke-linejoin', 'round');
    svg.setAttribute('aria-hidden', 'true');
    svg.setAttribute('focusable', 'false');

    for (const d of paths) {
      const path = document.createElementNS(SVG_NS, 'path');
      path.setAttribute('d', d);
      svg.append(path);
    }

    return svg;
  }

  /**
   * `localStorage` pour le visiteur, `sessionStorage` pour la conversation :
   * un nouvel onglet doit repartir d'une conversation vierge tout en gardant
   * le même quota journalier.
   */
  const VISITOR_KEY = 'signally.chat.visitorId';
  const CONVERSATION_KEY = 'signally.chat.conversationId';
  const TICKET_KEY = 'signally.chat.conversationTicket';

  /**
   * Copies des bornes de `chatRequestSchema`. Elles ne valident pas ce qu'on
   * envoie — la passerelle le refait — mais ce qu'on relit du stockage : une
   * valeur corrompue à la main produirait un 400 à chaque question, sans que
   * le visiteur puisse rien y faire.
   */
  const VISITOR_PATTERN = /^[A-Za-z0-9_-]{8,64}$/;
  const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

  /**
   * Volontairement large : le widget ne relit pas la structure du ticket, il
   * n'écarte qu'une valeur corrompue à la main. C'est la passerelle qui en
   * juge, et elle seule — dupliquer son format ici créerait une deuxième
   * définition à tenir alignée pour rien.
   */
  const TICKET_PATTERN = /^[A-Za-z0-9_.-]{1,256}$/;

  type StorageKind = 'localStorage' | 'sessionStorage';

  /**
   * Le simple accès à `window.localStorage` lève quand le stockage est bloqué
   * (navigation privée, réglage du navigateur, iframe tierce) : l'accès entier
   * est sous `try`, pas seulement l'appel.
   */
  function readStored(kind: StorageKind, key: string): string | null {
    try {
      return window[kind].getItem(key);
    } catch {
      return null;
    }
  }

  function writeStored(kind: StorageKind, key: string, value: string): void {
    try {
      window[kind].setItem(key, value);
    } catch {
      // Stockage indisponible : la valeur reste en mémoire pour la page.
    }
  }

  function forgetStored(kind: StorageKind, key: string): void {
    try {
      window[kind].removeItem(key);
    } catch {
      // Stockage indisponible : il n'y avait rien à retirer.
    }
  }

  /**
   * `crypto.randomUUID` n'existe qu'en contexte sécurisé (`https`, ou
   * `http://localhost`). Sur une origine non sécurisée non locale il est
   * absent, alors que `getRandomValues` reste disponible ; `Math.random` ne
   * ferme la marche que pour ne jamais lever. L'identifiant est opaque et
   * n'autorise rien par lui-même : la propriété d'une conversation est
   * vérifiée en base par l'API.
   */
  function randomToken(): string {
    try {
      if (typeof crypto !== 'undefined') {
        if (typeof crypto.randomUUID === 'function') return crypto.randomUUID();

        if (typeof crypto.getRandomValues === 'function') {
          const bytes = crypto.getRandomValues(new Uint8Array(16));
          return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
        }
      }
    } catch {
      // Repli ci-dessous.
    }

    let token = '';
    for (let i = 0; i < 32; i += 1) token += Math.floor(Math.random() * 16).toString(16);
    return token;
  }

  /** Réponse de la passerelle, relue champ par champ plutôt que crue sur parole. */
  type ChatAnswer = {
    ok: true;
    conversationId: string;
    /** Absent d'une passerelle plus ancienne : le tour suivant repasse alors par le défi. */
    conversationTicket: string | undefined;
    messageId: string;
    answer: string;
    refused: boolean;
    unanswered: boolean;
  };

  type ChatFailure = { ok: false; error: string; retryable: boolean };

  function readChatResponse(payload: unknown): ChatAnswer | ChatFailure | undefined {
    if (typeof payload !== 'object' || payload === null) return undefined;
    const raw = payload as Record<string, unknown>;

    if (raw.ok !== true) {
      // `error` arrive déjà dans la langue de la page : le widget ne porte
      // aucune table de correspondance et n'a rien à traduire.
      return typeof raw.error === 'string'
        ? { ok: false, error: raw.error, retryable: raw.retryable === true }
        : undefined;
    }

    if (
      typeof raw.conversationId !== 'string' ||
      typeof raw.messageId !== 'string' ||
      typeof raw.answer !== 'string'
    ) {
      return undefined;
    }

    return {
      ok: true,
      conversationId: raw.conversationId,
      conversationTicket:
        typeof raw.conversationTicket === 'string' ? raw.conversationTicket : undefined,
      messageId: raw.messageId,
      answer: raw.answer,
      refused: raw.refused === true,
      unanswered: raw.unanswered === true,
    };
  }

  /**
   * Le sous-ensemble de `window.turnstile` que ce widget utilise. Cloudflare
   * ne publie pas de types et le dépôt n'ajoute pas de dépendance : mieux vaut
   * un contrat écrit à la main, étroit et vérifié par le compilateur, qu'un
   * `any` qui laisserait passer une faute de frappe dans un nom d'option.
   */
  type TurnstileApi = {
    render: (
      container: HTMLElement,
      options: {
        sitekey: string;
        appearance?: 'always' | 'execute' | 'interaction-only';
        callback?: (token: string) => void;
        'error-callback'?: () => void;
        'expired-callback'?: () => void;
      }
    ) => string | undefined;
    reset: (widgetId?: string) => void;
  };

  const turnstileApi = (): TurnstileApi | undefined =>
    (window as unknown as { turnstile?: TurnstileApi }).turnstile;

  /**
   * `render=explicit` coupe le rendu automatique ; `onload` est le rendez-vous
   * documenté par Cloudflare pour savoir que `window.turnstile` est prêt —
   * l'événement `load` du `<script>` ne le garantit pas.
   */
  const TURNSTILE_ONLOAD = 'signallyTurnstileReady';
  const TURNSTILE_SRC =
    `https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=${TURNSTILE_ONLOAD}`;

  const root = document.querySelector<HTMLElement>('[data-support-chat]');

  if (root) {
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const log = root.querySelector<HTMLElement>('[data-log]')!;
    const turns = root.querySelector<HTMLElement>('[data-turns]')!;
    const starters = root.querySelector<HTMLElement>('[data-starters]')!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const input = root.querySelector<HTMLTextAreaElement>('[data-input]')!;
    const send = root.querySelector<HTMLButtonElement>('[data-send]')!;
    const pendingIndicator = root.querySelector<HTMLElement>('[data-pending]')!;

    const copy = {
      unanswered: root.dataset.unansweredText ?? '',
      contactPath: root.dataset.contactPath ?? '/',
      contactLabel: root.dataset.contactLabel ?? '',
      retry: root.dataset.retryLabel ?? '',
      up: root.dataset.upLabel ?? '',
      down: root.dataset.downLabel ?? '',
      thanks: root.dataset.thanksLabel ?? '',
      genericError: root.dataset.genericError ?? '',
    };

    const launcher = document.createElement('button');
    launcher.type = 'button';
    launcher.className = 'support-chat__launcher';
    launcher.setAttribute('aria-label', root.dataset.launcherLabel!);
    launcher.title = root.dataset.launcherLabel!;
    launcher.setAttribute('aria-expanded', 'false');
    launcher.setAttribute('aria-controls', panel.id);
    launcher.append(icon(24, [BUBBLE_PATH]));
    root.append(launcher);

    // La racine reste `hidden` tant que le script n'a pas tourné : c'est ce
    // qui garantit qu'un visiteur sans JavaScript ne voit rien du tout.
    root.hidden = false;

    // ---- État ----

    /**
     * Résolu à la première question et non à l'ouverture : rien de ce qui suit
     * ne doit pouvoir empêcher le panneau de s'ouvrir.
     */
    let visitorId: string | null = null;

    const ensureVisitorId = (): string => {
      if (visitorId !== null) return visitorId;

      const stored = readStored('localStorage', VISITOR_KEY);
      visitorId = stored !== null && VISITOR_PATTERN.test(stored) ? stored : randomToken();
      writeStored('localStorage', VISITOR_KEY, visitorId);
      return visitorId;
    };

    const storedConversation = readStored('sessionStorage', CONVERSATION_KEY);
    let conversationId: string | undefined =
      storedConversation !== null && UUID_PATTERN.test(storedConversation)
        ? storedConversation
        : undefined;

    /**
     * Le ticket voyage avec le `conversationId` et ne vaut rien sans lui : la
     * passerelle n'exempte du défi que sur le couple. Rangé dans le même
     * `sessionStorage`, il a donc exactement la même durée de vie.
     */
    const storedTicket = readStored('sessionStorage', TICKET_KEY);
    let conversationTicket: string | undefined =
      conversationId !== undefined && storedTicket !== null && TICKET_PATTERN.test(storedTicket)
        ? storedTicket
        : undefined;

    const forgetTicket = () => {
      conversationTicket = undefined;
      forgetStored('sessionStorage', TICKET_KEY);
    };

    let inFlight = false;
    let lastQuestion = '';
    let errorBlock: HTMLElement | null = null;

    const scrollToEnd = () => {
      log.scrollTop = log.scrollHeight;
    };

    // ---- Turnstile ----

    /**
     * Le script de Cloudflare n'est demandé qu'à la **première ouverture** du
     * panneau, et seulement si la clé publique est configurée.
     *
     * Ce chargement paresseux et conditionnel est un **choix de posture, pas
     * une optimisation** : le site tient à n'émettre aucune requête tierce
     * pour un visiteur qui n'ouvre pas le chat. Ne remonte donc pas ce
     * `<script>` dans le markup ni dans `Base.astro`, n'ajoute ni `preconnect`
     * ni `dns-prefetch` vers Cloudflare, et ne repasse pas au rendu automatique
     * par attributs `cf-*` — le rendu automatique s'exécute au chargement du
     * script et rendrait tout ceci inutile.
     *
     * Si Cloudflare ne répond pas, l'échec est silencieux pour le visiteur :
     * le panneau s'ouvre, la question part sans jeton, et la passerelle
     * décide. Un chat qui refuse de s'ouvrir parce qu'un tiers est en panne
     * serait un pire résultat que le risque qu'il couvre.
     */
    const siteKey = root.dataset.turnstileSiteKey ?? '';
    const turnstileHost = root.querySelector<HTMLElement>('[data-turnstile]');

    /**
     * Le jeton est à usage unique et expire : il ne vit qu'ici, en mémoire, le
     * temps d'une question. Ni `localStorage`, ni `sessionStorage`, ni
     * réutilisation d'un message au suivant — et jamais de journalisation.
     */
    let turnstileToken: string | null = null;
    let turnstileWidget: string | undefined;
    let turnstileRequested = false;

    /**
     * Attente bornée du jeton, avant un envoi que le ticket ne couvre pas.
     *
     * Sans elle, une question tapée vite — ou un Cloudflare lent, le script
     * n'étant demandé qu'à l'ouverture du panneau — partait sans jeton et se
     * faisait refuser par la passerelle, avec un message que le visiteur ne
     * pouvait ni comprendre ni corriger.
     *
     * L'attente est bornée, et c'est le point : au-delà on envoie quand même
     * et la passerelle tranche, exactement comme avant. Un tiers en panne ou
     * bloqué par une extension ne doit pas figer l'envoi — juste le faire
     * échouer, ce qu'il faisait déjà. Le visiteur voit l'indicateur d'attente
     * pendant ce délai : `ask` l'affiche avant d'attendre.
     */
    const TURNSTILE_WAIT_MS = 4000;

    let tokenWaiters: Array<() => void> = [];

    /** Le sort du jeton est scellé — arrivé, expiré, en échec : plus rien à attendre. */
    const releaseTokenWaiters = () => {
      const waiters = tokenWaiters;
      tokenWaiters = [];
      for (const resolve of waiters) resolve();
    };

    const awaitTurnstileToken = (): Promise<void> =>
      new Promise<void>((resolve) => {
        // Jeton déjà là, ou pas de Turnstile du tout : rien à attendre.
        if (turnstileToken !== null || siteKey === '' || turnstileHost === null) {
          resolve();
          return;
        }

        const done = () => {
          window.clearTimeout(timer);
          tokenWaiters = tokenWaiters.filter((waiter) => waiter !== done);
          resolve();
        };

        const timer = window.setTimeout(done, TURNSTILE_WAIT_MS);
        tokenWaiters.push(done);
      });

    const renderTurnstile = () => {
      const api = turnstileApi();
      if (api === undefined || turnstileHost === null) return;

      try {
        turnstileWidget = api.render(turnstileHost, {
          sitekey: siteKey,
          // Mode géré : le défi ne se montre au visiteur que si Cloudflare le
          // réclame, et il se montre dans le panneau, pas ailleurs.
          appearance: 'interaction-only',
          callback: (token) => {
            turnstileToken = token;
            releaseTokenWaiters();
          },
          // Un jeton expiré ou un défi en échec ne disent rien au visiteur :
          // on repart sans jeton et la passerelle tranche.
          'expired-callback': () => {
            turnstileToken = null;
            releaseTokenWaiters();
          },
          'error-callback': () => {
            turnstileToken = null;
            releaseTokenWaiters();
          },
        });
      } catch {
        // Turnstile indisponible : l'envoi partira sans jeton, sans attendre.
        releaseTokenWaiters();
      }
    };

    const loadTurnstile = () => {
      // Pas de clé publique, pas de conteneur, ou script déjà demandé : rien
      // ne part vers Cloudflare.
      if (turnstileRequested || siteKey === '' || turnstileHost === null) return;
      turnstileRequested = true;

      (window as unknown as Record<string, unknown>)[TURNSTILE_ONLOAD] = renderTurnstile;

      // `createElement`, jamais une chaîne de balisage : ce fichier n'a aucun
      // puits d'injection HTML, y compris pour injecter son propre tiers.
      // Aucun écouteur d'erreur : un chargement raté ne laisse simplement pas
      // de `window.turnstile`, ce qui est déjà le comportement voulu.
      const script = document.createElement('script');
      script.src = TURNSTILE_SRC;
      script.async = true;
      document.head.append(script);
    };

    /** Consommer un jeton le retire de la mémoire : il ne resservira pas. */
    const takeTurnstileToken = (): string | undefined => {
      const token = turnstileToken ?? undefined;
      turnstileToken = null;
      return token;
    };

    /** Redemande un jeton frais après en avoir dépensé un sans aboutir. */
    const resetTurnstile = () => {
      const api = turnstileApi();
      turnstileToken = null;
      if (api === undefined || turnstileWidget === undefined) return;

      try {
        api.reset(turnstileWidget);
      } catch {
        // Rien à faire : l'envoi suivant partira sans jeton.
      }
    };

    // ---- Ouverture, fermeture, clavier ----

    const open = () => {
      panel.hidden = false;
      launcher.setAttribute('aria-expanded', 'true');
      // Une image après le retrait de `hidden`, sinon la transition d'entrée
      // n'a pas d'état de départ à animer.
      requestAnimationFrame(() => panel.classList.add('is-open'));
      input.focus();
      scrollToEnd();
      // La seule requête tierce du site part d'ici, et de nulle part ailleurs.
      loadTurnstile();
    };

    const close = () => {
      panel.classList.remove('is-open');
      panel.hidden = true;
      launcher.setAttribute('aria-expanded', 'false');
      launcher.focus();
    };

    // Le lanceur porte aussi la fermeture : le dictionnaire n'a pas de libellé
    // « fermer », et inventer une chaîne ici est interdit. `aria-expanded`
    // porte l'état, et Échap reste le raccourci attendu.
    launcher.addEventListener('click', () => {
      if (panel.hidden) open();
      else close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) close();
    });

    // Les amorces remplissent le champ sans rien envoyer : le visiteur relit
    // et complète sa question avant de la poser.
    for (const starter of root.querySelectorAll<HTMLButtonElement>('[data-starter]')) {
      starter.addEventListener('click', () => {
        input.value = starter.textContent ?? '';
        input.focus();
      });
    }

    // ---- Rendu de la réponse ----

    /**
     * Une cible externe ne devient un `href` que si son schéma est http(s).
     *
     * Défense en profondeur : `localizeAnswerLinks` réduit déjà en texte brut
     * tout lien hors liste blanche, donc cette branche ne devrait jamais
     * s'exécuter. Si elle s'exécute quand même, elle ne doit pas transformer
     * un `javascript:` en lien cliquable — un lien refusé perd son URL, jamais
     * son libellé. Ce n'est pas la liste blanche refaite côté navigateur : ça
     * ne relocalise rien et ça n'élargit rien.
     */
    const externalHref = (target: string): string | null => {
      try {
        const url = new URL(target, window.location.href);
        return url.protocol === 'https:' || url.protocol === 'http:' ? url.href : null;
      } catch {
        return null;
      }
    };

    const inlineNodes = (text: string): Node[] => {
      const nodes: Node[] = [];

      for (const token of parseInline(text)) {
        if (token.type === 'text') {
          nodes.push(document.createTextNode(token.text));
          continue;
        }

        if (token.type === 'bold') {
          const strong = document.createElement('strong');
          strong.textContent = token.text;
          nodes.push(strong);
          continue;
        }

        // Un chemin interne part tel quel : la passerelle l'a déjà localisé et
        // mis en liste blanche, le retoucher ici ne pourrait que l'affaiblir.
        const href = token.internal ? token.target : externalHref(token.target);

        if (href === null) {
          nodes.push(document.createTextNode(token.label));
          continue;
        }

        const link = document.createElement('a');
        link.href = href;
        link.textContent = token.label;

        if (!token.internal) {
          link.target = '_blank';
          link.rel = 'noreferrer noopener';
        }

        nodes.push(link);
      }

      return nodes;
    };

    const answerNode = (text: string): HTMLElement => {
      const container = document.createElement('div');
      container.className = 'support-chat__turn support-chat__turn--bot';

      for (const block of splitBlocks(text)) {
        if (block.type === 'paragraph') {
          const paragraph = document.createElement('p');
          // Les retours simples restent des retours : le `pre-wrap` du style
          // les rend sans qu'aucun `<br>` n'ait à être fabriqué.
          paragraph.append(...inlineNodes(block.lines.join('\n')));
          container.append(paragraph);
          continue;
        }

        const list = document.createElement(block.ordered ? 'ol' : 'ul');
        for (const line of block.lines) {
          const item = document.createElement('li');
          item.append(...inlineNodes(stripMarker(line)));
          list.append(item);
        }
        container.append(list);
      }

      return container;
    };

    /** La copie du dictionnaire, suivie du lien vers la page de contact localisée. */
    const unansweredNote = (): HTMLElement => {
      const note = document.createElement('p');
      note.className = 'support-chat__note';
      note.append(copy.unanswered, ' ');

      const link = document.createElement('a');
      link.href = copy.contactPath;
      link.textContent = copy.contactLabel;
      note.append(link);

      return note;
    };

    // ---- Pouces ----

    const rate = async (messageId: string, feedback: 'up' | 'down'): Promise<boolean> => {
      try {
        const response = await fetch('/api/chat-feedback', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ messageId, visitorId: ensureVisitorId(), feedback }),
        });
        return response.ok;
      } catch {
        return false;
      }
    };

    const feedbackRow = (messageId: string): HTMLElement => {
      const row = document.createElement('div');
      row.className = 'support-chat__feedback';

      const thanks = document.createElement('span');
      thanks.className = 'support-chat__thanks';
      thanks.textContent = copy.thanks;
      thanks.hidden = true;

      const buttons: HTMLButtonElement[] = [];

      const vote = async (button: HTMLButtonElement, feedback: 'up' | 'down') => {
        // Un seul vote par message, et le retour est immédiat : un pouce qui
        // attend un aller-retour paraît cassé.
        for (const other of buttons) other.disabled = true;
        button.setAttribute('aria-pressed', 'true');
        thanks.hidden = false;

        if (await rate(messageId, feedback)) return;

        // Un pouce perdu n'est pas un incident pour le visiteur : on rend la
        // main sans rien afficher plutôt que d'interrompre la conversation.
        button.setAttribute('aria-pressed', 'false');
        thanks.hidden = true;
        for (const other of buttons) other.disabled = false;
      };

      const options = [
        ['up', copy.up, THUMB_UP_PATHS],
        ['down', copy.down, THUMB_DOWN_PATHS],
      ] as const;

      for (const [feedback, label, paths] of options) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'support-chat__vote';
        button.setAttribute('aria-label', label);
        button.title = label;
        button.setAttribute('aria-pressed', 'false');
        button.append(icon(15, paths));
        button.addEventListener('click', () => void vote(button, feedback));
        buttons.push(button);
        row.append(button);
      }

      row.append(thanks);
      return row;
    };

    // ---- Tours et erreurs ----

    const appendUserTurn = (text: string) => {
      starters.hidden = true;
      const turn = document.createElement('p');
      turn.className = 'support-chat__turn support-chat__turn--user';
      turn.textContent = text;
      turns.append(turn);
      scrollToEnd();
    };

    const appendAnswer = (data: ChatAnswer) => {
      const group = document.createElement('div');
      group.className = 'support-chat__answer';
      group.append(answerNode(data.answer));

      if (data.unanswered) group.append(unansweredNote());

      // Un refus ne vient pas du corpus : le noter n'apprendrait rien.
      if (!data.refused) group.append(feedbackRow(data.messageId));

      turns.append(group);
      scrollToEnd();
    };

    const clearError = () => {
      errorBlock?.remove();
      errorBlock = null;
    };

    const showError = (message: string, retryable: boolean) => {
      clearError();

      const block = document.createElement('div');
      block.className = 'support-chat__error';
      block.setAttribute('role', 'alert');

      const text = document.createElement('p');
      text.textContent = message;
      block.append(text);

      // Le bouton n'apparaît que si la passerelle a dit que réessayer a un
      // sens : sur un quota atteint ou un message trop long, réémettre la même
      // question ne ferait que reproduire la même erreur.
      if (retryable && lastQuestion !== '') {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'support-chat__retry';
        button.textContent = copy.retry;
        // La question repart telle quelle : le visiteur n'a pas à la retaper,
        // et son tour est déjà affiché — inutile de le dupliquer.
        button.addEventListener('click', () => void ask(lastQuestion, true));
        block.append(button);
      }

      errorBlock = block;
      turns.append(block);
      scrollToEnd();
    };

    // ---- Envoi ----

    /**
     * Le contrat de `chatRequestSchema`, et rien de plus. Aucune transcription
     * ne part : l'historique vit côté API, rejoué depuis le `conversationId`.
     */
    const requestBody = (question: string): Record<string, string> => {
      const body: Record<string, string> = {
        question,
        visitorId: ensureVisitorId(),
        locale: root.dataset.locale ?? 'fr',
      };

      // Le `conversationId` part même sans son ticket : c'est l'API qui
      // tranche la propriété en base, et un visiteur dont le ticket a expiré
      // doit retrouver son historique — il repassera simplement par le défi.
      if (conversationId !== undefined) body.conversationId = conversationId;
      if (conversationTicket !== undefined) body.conversationTicket = conversationTicket;

      // Le jeton n'accompagne que les envois que le ticket ne couvre pas :
      // premier message, ticket perdu, ticket périmé après un refus. Symétrie
      // exacte de l'attente dans `ask` — et un envoi couvert par le ticket ne
      // dépense donc aucun jeton. S'il n'y en a pas — pas de clé publique,
      // Cloudflare muet — on part sans et la passerelle décide, comme avant.
      if (conversationTicket === undefined) {
        const token = takeTurnstileToken();
        if (token !== undefined) body.turnstileToken = token;
      }

      const pageKey = root.dataset.pageKey;
      if (pageKey) body.pageKey = pageKey;

      return body;
    };

    const ask = async (question: string, replay = false) => {
      // Une seule requête à la fois : la conversation est séquentielle côté
      // API, et deux questions parallèles s'y entremêleraient.
      if (inFlight) return;

      inFlight = true;
      lastQuestion = question;
      clearError();
      if (!replay) appendUserTurn(question);

      send.disabled = true;
      pendingIndicator.hidden = false;
      scrollToEnd();

      // Tant qu'aucun ticket ne couvre la conversation, la passerelle exigera
      // un jeton : autant le laisser arriver plutôt que d'envoyer pour rien.
      if (conversationTicket === undefined) await awaitTurnstileToken();

      const body = requestBody(question);
      const spentToken = body.turnstileToken !== undefined;
      let refusedByGuard = false;

      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });

        let payload: unknown;
        try {
          payload = await response.json();
        } catch {
          payload = undefined;
        }

        // Le garde a refusé : le ticket qu'on croyait valable ne l'est pas,
        // et le jeton présenté est brûlé. On oublie l'un et on réarme l'autre
        // pour que « réessayer » ait une chance d'aboutir.
        if (response.status === 403) {
          refusedByGuard = true;
          forgetTicket();
        }

        const data = readChatResponse(payload);

        if (data === undefined) {
          showError(copy.genericError, true);
        } else if (data.ok) {
          conversationId = data.conversationId;
          writeStored('sessionStorage', CONVERSATION_KEY, data.conversationId);

          // Le ticket du tour suivant. Absent d'une passerelle plus ancienne :
          // on oublie alors celui qu'on avait plutôt que de le garder périmé.
          if (data.conversationTicket !== undefined) {
            conversationTicket = data.conversationTicket;
            writeStored('sessionStorage', TICKET_KEY, data.conversationTicket);
          } else {
            forgetTicket();
          }

          appendAnswer(data);
        } else {
          showError(data.error, data.retryable);
        }
      } catch {
        // Panne réseau : la passerelle n'a rien dit du tout, donc rien à
        // afficher tel quel. C'est le seul cas où la copie du dictionnaire
        // sert, et réessayer a un sens.
        showError(copy.genericError, true);
      } finally {
        inFlight = false;
        send.disabled = false;
        pendingIndicator.hidden = true;
        scrollToEnd();

        // Un jeton dépensé ne vaut plus rien, et un envoi refusé par le garde
        // n'a plus de ticket à opposer : dans les deux cas la tentative
        // suivante a besoin d'un jeton neuf. Avec un ticket en poche, elle
        // n'en aura pas besoin — et réarmer jetterait un jeton encore intact.
        if (conversationTicket === undefined && (spentToken || refusedByGuard)) resetTurnstile();
      }
    };

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const question = input.value.trim();
      if (question === '' || inFlight) return;

      input.value = '';
      input.focus();
      void ask(question);
    });
  }
</script>
