---
import Faq from './Faq.astro';
import type { FaqItem } from '../data/faq';

interface Props {
  title: string;
  items: FaqItem[];
  eyebrow?: string;
  background?: 'white' | 'soft';
}

const { title, items, eyebrow, background = 'white' } = Astro.props;
---

<section class:list={['section', background === 'soft' ? 'section--soft' : 'section--white']}>
  <div class="container-narrow">
    {eyebrow && <div class="eyebrow">{eyebrow}</div>}
    <h2 class="faqsec__title">{title}</h2>
    <Faq items={items} />
  </div>
</section>

<style>
  .faqsec__title {
    font-size: 34px;
    line-height: 1.14;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0 0 36px;
  }

  @media (max-width: 1024px) { .faqsec__title { font-size: 28px; } }
  @media (max-width: 560px) { .faqsec__title { font-size: 24px; margin-bottom: 26px; } }
</style>
