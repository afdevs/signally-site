---
import '@fontsource-variable/manrope';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/tokens.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, APP_URL, CONTACT_EMAIL } from '../data/nav';
import { getDictionary } from '../i18n';
import {
  DEFAULT_LOCALE,
  LOCALE_META,
  PUBLISHED_LOCALES,
  localeFromPath,
  type Locale,
} from '../i18n/config';
import { pageKeyOf, localizedPath, localesWithPage } from '../i18n/routes';

interface Props {
  title: string;
  description: string;
  /** Chemin canonique, ex. « /tarifs ». Par défaut, l'URL courante. */
  path?: string;
  noindex?: boolean;
  /** Données structurées supplémentaires (FAQPage, Article, HowTo…). */
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  /** Langue de la page. Déduite de l'URL si elle n'est pas passée. */
  locale?: Locale;
  /**
   * Équivalents linguistiques, pour les pages absentes de la table de
   * routes — les articles de blog, dont le slug est propre à chaque
   * langue. Les autres pages sont appariées automatiquement.
   */
  alternates?: Partial<Record<Locale, string>>;
}

const {
  title,
  description,
  path,
  noindex = false,
  jsonLd = [],
  ogType = 'website',
  locale = localeFromPath(Astro.url.pathname),
  alternates,
} = Astro.props;

const { common, seo } = getDictionary(locale);
const meta = LOCALE_META[locale];

const canonicalPath = path ?? Astro.url.pathname;
const canonical = new URL(canonicalPath, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
const ogImage = new URL('/og-default.png', SITE.url).href;

/**
 * Alternatives linguistiques réellement publiées. On n'annonce jamais à
 * un moteur une URL qui n'existe pas encore : tant qu'une langue n'est
 * pas dans `PUBLISHED_LOCALES`, elle est absente des `hreflang`.
 */
const pageKey = pageKeyOf(canonicalPath);
const alternatePaths = PUBLISHED_LOCALES.map((code) => {
  const exists = pageKey ? localesWithPage(pageKey).includes(code) : false;
  const href = alternates?.[code] ?? (exists ? localizedPath(pageKey!, code) : undefined);
  return href ? { code, href: new URL(href, SITE.url).href } : undefined;
}).filter((entry) => entry !== undefined);

/** `hreflang` n'a de sens qu'à partir de deux versions appariées. */
const showAlternates = alternatePaths.length > 1;
const defaultAlternate = alternatePaths.find((entry) => entry.code === DEFAULT_LOCALE);

/**
 * Entités de marque présentes sur toutes les pages. Le prototype
 * (page « Plan éditorial SEO ») demande explicitement Organization
 * et Product/SoftwareApplication, avec des chiffres tarifaires
 * explicites pour l'optimisation GEO.
 */
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/signally-logo.png', SITE.url).href,
  description: common.site.description,
  email: CONTACT_EMAIL,
  areaServed: seo.areaServed,
  // TODO — à compléter par Signally : adresse postale, téléphone, SIREN,
  // contact DPO. Le prototype laisse ce bloc explicitement vide
  // (« Bloc à compléter »), rien n'est inventé ici.
};

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${SITE.url}/#software`,
  name: SITE.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, Microsoft Outlook, Google Workspace',
  url: APP_URL,
  publisher: { '@id': `${SITE.url}/#organization` },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: '0.50',
    highPrice: '1.50',
    offerCount: 5,
    description: seo.offerDescription,
  },
};

const allLd = [organizationLd, softwareLd, ...jsonLd];
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    {showAlternates && alternatePaths.map((entry) => (
      <link rel="alternate" hreflang={LOCALE_META[entry.code].htmlLang} href={entry.href} />
    ))}
    {showAlternates && defaultAlternate && (
      <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={meta.ogLocale} />
    {showAlternates && alternatePaths
      .filter((entry) => entry.code !== locale)
      .map((entry) => (
        <meta property="og:locale:alternate" content={LOCALE_META[entry.code].ogLocale} />
      ))}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#1a1a1a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {allLd.map((ld) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>

  <body>
    <a class="skip-link" href="#contenu">{common.layout.skipToContent}</a>
    <Header locale={locale} />
    <main id="contenu">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
