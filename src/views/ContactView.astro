---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { APP_SIGNUP_URL, CONTACT_EMAIL } from '../data/nav';
import { getDictionary } from '../i18n';
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { common, contact: t } = getDictionary(locale);
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path={localizedPath('contact', locale)}
  locale={locale}
>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} lede={t.hero.lede} tight />

  <section class="contact">
    <div class="container contact__grid">
      <ContactForm locale={locale} />

      <aside class="contact__side">
        <div class="side-card side-card--soft">
          <h2 class="side-card__title">{t.side.tryTitle}</h2>
          <p class="side-card__text">{t.side.tryText}</p>
          <a href={APP_SIGNUP_URL} class="btn btn--ink btn--sm" target="_blank" rel="noopener">
            {common.actions.signup}
          </a>
        </div>

        <div class="side-card">
          <div class="side-card__tag">{t.side.tag}</div>
          <ul class="side-card__list">
            {t.side.points.map((point) => <li>{point}</li>)}
          </ul>
          <div class="side-card__mail">
            {t.side.mailLabel} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          </div>
          {/*
            TODO — Signally : le prototype laisse ce bloc à compléter.
            Adresse postale, téléphone, SIREN et contact DPO doivent venir
            de vous ; rien n'est inventé ici.
          */}
          <div class="side-card__todo">{t.side.todo}</div>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact { padding: 72px 0 96px; background: var(--white); }

  .contact__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: start;
  }

  .contact__side {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .side-card {
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: 28px;
  }
  .side-card--soft { background: var(--soft); }

  .side-card__title { font-size: 19px; font-weight: 800; margin: 0 0 10px; }

  .side-card__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--sec);
    margin: 0 0 16px;
  }

  .side-card__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .side-card__list {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .side-card__mail {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--sec);
  }
  .side-card__mail a { font-weight: 700; color: var(--link-hover); }

  .side-card__todo {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 1024px) {
    .contact { padding: 56px 0 72px; }
    .contact__grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
