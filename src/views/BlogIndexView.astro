---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CLUSTERS, type Cluster } from '../data/clusters';
import { articlesInEditorialOrder } from '../lib/blog';
import { getDictionary } from '../i18n';
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).blog;

// L'ordre et la couverture viennent du plan éditorial français ; une
// langue n'affiche que les articles qui y sont effectivement traduits.
const posts = await articlesInEditorialOrder(locale);

const counts = new Map<Cluster, number>();
for (const post of posts) counts.set(post.cluster, (counts.get(post.cluster) ?? 0) + 1);

const filters: { label: string; value: string; count: number }[] = [
  { label: t.index.all, value: 'all', count: posts.length },
  ...CLUSTERS.filter((c) => counts.has(c)).map((c) => ({
    // La valeur reste la clé technique : c'est elle que le script filtre.
    label: t.clusters[c],
    value: c,
    count: counts.get(c) ?? 0,
  })),
];
---

<Base
  title={t.index.meta.title}
  description={t.index.meta.description}
  path={localizedPath('blog', locale)}
  locale={locale}
>
  <PageHero eyebrow={t.index.eyebrow} title={t.index.title} lede={t.index.lede} tight />

  <section class="blog">
    <div class="container">
      <div class="filters" role="group" aria-label={t.index.filterAria}>
        {filters.map((f, i) => (
          <button
            type="button"
            class="chip"
            data-filter={f.value}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {f.label}
            <span class="chip__count">{f.count}</span>
          </button>
        ))}
      </div>

      <p class="results" data-results aria-live="polite">
        {posts.length} {posts.length > 1 ? t.index.countMany : t.index.countOne}
      </p>

      {posts.length > 0 ? (
        <div class="posts" data-posts>
          {posts.map((post, i) => (
            <ArticleCard
              href={post.href}
              title={post.title}
              cluster={post.cluster}
              keyword={post.keyword}
              description={post.description}
              index={i}
              locale={locale}
            />
          ))}
        </div>
      ) : (
        <p class="empty">{t.index.empty}</p>
      )}

      <p class="empty" data-empty hidden>{t.index.emptyFiltered}</p>
    </div>
  </section>
</Base>

<style>
  .blog { padding: 40px 0 96px; background: var(--white); }

  .filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    padding: 24px 0 32px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 24px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 13.5px;
    font-weight: 700;
    padding: 9px 16px;
    border-radius: var(--r-pill);
    cursor: pointer;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink-2);
    transition: all 0.15s ease;
  }
  .chip:hover { border-color: var(--ink); }
  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }

  .chip__count {
    font-family: var(--font-mono);
    font-size: 10.5px;
    opacity: 0.65;
  }

  .results {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0 0 24px;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .empty {
    font-size: 16px;
    color: var(--sec);
    padding: 32px 0;
  }
  .empty[hidden] { display: none; }

  @media (max-width: 1024px) {
    .posts { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 680px) {
    .blog { padding: 24px 0 64px; }
    .posts { grid-template-columns: 1fr; }
  }
</style>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-cat]'));
  const results = document.querySelector<HTMLElement>('[data-results]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  function apply(value: string, pushState: boolean) {
    let visible = 0;

    for (const card of cards) {
      const match = value === 'all' || card.dataset.cat === value;
      card.hidden = !match;
      if (match) visible += 1;
    }

    for (const chip of chips) {
      chip.setAttribute('aria-pressed', String(chip.dataset.filter === value));
    }

    if (results) {
      results.textContent = `${visible} article${visible > 1 ? 's' : ''}`;
    }
    if (empty) empty.hidden = visible > 0;

    // La sélection est reflétée dans l'URL : une vue filtrée est partageable.
    if (pushState) {
      const url = new URL(window.location.href);
      if (value === 'all') url.searchParams.delete('cat');
      else url.searchParams.set('cat', value);
      history.replaceState(null, '', url);
    }
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => apply(chip.dataset.filter!, true));
  }

  // Restaure ?cat= au chargement.
  const initial = new URL(window.location.href).searchParams.get('cat');
  if (initial && chips.some((c) => c.dataset.filter === initial)) apply(initial, false);
</script>
