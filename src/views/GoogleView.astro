---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Satellites from '../components/Satellites.astro';
import { faqPageLd } from '../data/faq';
import { getDictionary } from '../i18n';
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).integrations.google;

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t.howToName,
  step: t.steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.title,
    text: s.text,
  })),
};
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path={localizedPath('google', locale)}
  locale={locale}
  jsonLd={[faqPageLd(t.faq.items), howToLd]}
>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} lede={t.hero.lede} />

  <section class="section section--white">
    <div class="container">
      <h2 class="sec__title">{t.stepsTitle}</h2>
      <div class="grid grid--4">
        {t.steps.map((s) => (
          <div class="card">
            <div class="step-num">{s.n}</div>
            <h3 class="step__title">{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>

      <div class="callout">
        <h3 class="callout__title">{t.callout.title}</h3>
        <p class="callout__text">{t.callout.text}</p>
      </div>
    </div>
  </section>

  <FaqSection title={t.faq.title} items={t.faq.items} background="soft" />

  <Satellites pillar="google" locale={locale} />

  <CtaBand
    locale={locale}
    title={t.cta.title}
    text={t.cta.text}
    secondaryLabel={t.cta.secondaryLabel}
  />
</Base>

<style>
  .sec__title {
    font-size: 36px;
    line-height: 1.14;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0 0 44px;
    max-width: 760px;
  }

  .step__title { font-size: 17px; }

  .callout {
    margin-top: 32px;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 28px;
    background: var(--brand-surface);
  }

  .callout__title { font-size: 19px; font-weight: 800; margin: 0 0 10px; }
  .callout__text {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--ink-4);
    margin: 0;
    max-width: 900px;
  }

  @media (max-width: 1024px) { .sec__title { font-size: 29px; margin-bottom: 32px; } }
  @media (max-width: 560px) {
    .sec__title { font-size: 25px; }
    .callout { padding: 22px; }
  }
</style>
