---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Satellites from '../components/Satellites.astro';
import { getDictionary } from '../i18n';
import { hasBlog, type Locale } from '../i18n/config';
import { localizedPath } from '../i18n/routes';
import { articleByKey } from '../lib/blog';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).compare;

/**
 * Les comparaisons détaillées renvoient vers un article de blog désigné
 * par sa **clé**, pas par son slug : celui-ci change d'une langue à
 * l'autre. La collection fait la résolution. Une carte dont l'article
 * n'existe pas dans la langue reste affichée sans lien, avec la mention
 * « bientôt publié » — ce qui est exact.
 */
const alternatives = await Promise.all(
  t.alternatives.items.map(async (item) => {
    const article = item.article && hasBlog(locale)
      ? await articleByKey(locale, item.article)
      : undefined;
    return { ...item, href: article?.href ?? null };
  }),
);
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path={localizedPath('compare', locale)}
  locale={locale}
>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} lede={t.hero.lede} />

  <section class="crit">
    <div class="container">
      <h2 class="sec__title">{t.criteria.title}</h2>
      <p class="sec__lede">{t.criteria.lede}</p>

      <div class="crit__grid">
        {t.criteria.items.map((c) => (
          <div class="crit__card">
            <div class="crit__n">{c.n}</div>
            <h3 class="crit__title">{c.title}</h3>
            <p class="crit__text">{c.text}</p>
            <div class="crit__answer">{c.answer}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="alts">
    <div class="container">
      <h2 class="sec__title">{t.alternatives.title}</h2>
      <p class="sec__lede">{t.alternatives.lede}</p>

      <div class="alts__grid">
        {alternatives.map((page) =>
          page.href ? (
            <a href={page.href} class="alt alt--link">
              <div class="alt__kw">{page.keyword}</div>
              <h3 class="alt__title">{page.title}</h3>
              <p class="alt__desc">{page.desc}</p>
              <span class="alt__cta">{t.alternatives.readMore}</span>
            </a>
          ) : (
            <div class="alt alt--soon">
              <div class="alt__kw">{page.keyword}</div>
              <h3 class="alt__title">{page.title}</h3>
              <p class="alt__desc">{page.desc}</p>
              <span class="alt__badge">{t.alternatives.soon}</span>
            </div>
          )
        )}
      </div>

      <p class="alts__note">{t.alternatives.note}</p>
    </div>
  </section>

  <Satellites pillar="compare" locale={locale} />

  {/*
    Règle de maillage du prototype : « Les pages comparatives renvoient
    vers Tarifs et Sécurité, jamais l'inverse. »
  */}
  <section class="crosslinks">
    <div class="container">
      <a href={localizedPath('pricing', locale)} class="crosslink">
        <span class="crosslink__label">{t.crosslinks.pricing.label}</span>
        <span class="crosslink__desc">{t.crosslinks.pricing.desc}</span>
      </a>
      <a href={localizedPath('security', locale)} class="crosslink">
        <span class="crosslink__label">{t.crosslinks.security.label}</span>
        <span class="crosslink__desc">{t.crosslinks.security.desc}</span>
      </a>
    </div>
  </section>

  <CtaBand
    locale={locale}
    title={t.cta.title}
    text={t.cta.text}
    secondaryLabel={t.cta.secondaryLabel}
  />
</Base>

<style>
  .crit { padding: 80px 0; background: var(--white); }
  .alts { padding: 80px 0; background: var(--soft); }

  .sec__title {
    font-size: 34px;
    line-height: 1.14;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0 0 12px;
  }

  .sec__lede {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--sec);
    margin: 0 0 40px;
    max-width: 760px;
  }

  .crit__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .crit__card {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 26px;
  }

  .crit__n {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .crit__title { font-size: 18px; font-weight: 800; margin: 0 0 8px; }

  .crit__text {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--sec);
    margin: 0 0 10px;
  }

  .crit__answer { font-size: 14px; font-weight: 700; color: var(--link-hover); }

  .alts__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .alt {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .alt--link { text-decoration: none; transition: border-color 0.16s ease; }
  .alt--link:hover { border-color: var(--brand); text-decoration: none; }

  .alt__kw {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 2px;
  }

  .alt__title { font-size: 17.5px; font-weight: 800; margin: 0; line-height: 1.3; }

  .alt__desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--sec);
    margin: 0;
    flex: 1;
  }

  .alt__cta { font-size: 13.5px; font-weight: 700; color: var(--link-hover); margin-top: 6px; }

  .alt__badge {
    align-self: flex-start;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 4px 10px;
  }

  .alts__note {
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    margin: 28px 0 0;
    max-width: 820px;
  }

  .crosslinks {
    padding: 56px 0;
    background: var(--white);
  }
  .crosslinks .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .crosslink {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--brand);
    border-radius: var(--r-lg);
    padding: 22px 26px;
    text-decoration: none;
    transition: background 0.16s ease;
  }
  .crosslink:hover { background: var(--brand-surface); text-decoration: none; }

  .crosslink__label { font-size: 16.5px; font-weight: 800; color: var(--ink); }
  .crosslink__desc { font-size: 14px; color: var(--sec); }

  @media (max-width: 1024px) {
    .crit, .alts { padding: 56px 0; }
    .sec__title { font-size: 28px; }
    .alts__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .crit__grid { grid-template-columns: 1fr; }
    .alts__grid { grid-template-columns: 1fr; }
    .crosslinks .container { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .sec__title { font-size: 24px; }
    .crit__card, .alt { padding: 22px; }
  }
</style>
