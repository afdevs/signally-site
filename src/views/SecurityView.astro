---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Satellites from '../components/Satellites.astro';
import { faqPageLd } from '../data/faq';
import { getDictionary } from '../i18n';
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).security;
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path={localizedPath('security', locale)}
  locale={locale}
  jsonLd={[faqPageLd(t.faq.items)]}
>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} lede={t.hero.lede} />

  <section class="section section--white">
    <div class="container">
      <div class="scope">
        <div class="scope__col">
          <div class="scope__tag">{t.scope.doesTag}</div>
          <ul class="scope__list">
            {t.scope.does.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="scope__col scope__col--dark on-dark">
          <div class="scope__tag scope__tag--brand">{t.scope.doesNotTag}</div>
          <ul class="scope__list scope__list--light">
            {t.scope.doesNot.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <div class="grid grid--3 guarantees">
        {t.guarantees.map((g) => (
          <div class="card">
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </div>
        ))}
      </div>

      {/*
        TODO — Signally : bloc laissé volontairement vide dans le
        prototype. Il attend des éléments contractuels réels, qui ne
        peuvent pas être inventés ici.
      */}
      <div class="todo">{t.todo}</div>
    </div>
  </section>

  <FaqSection title={t.faq.title} items={t.faq.items} background="soft" />

  <Satellites pillar="security" locale={locale} />

  <CtaBand
    locale={locale}
    title={t.cta.title}
    text={t.cta.text}
    secondaryLabel={t.cta.secondaryLabel}
  />
</Base>

<style>
  .scope {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .scope__col {
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: 32px;
  }

  .scope__col--dark {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--white);
  }

  .scope__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .scope__tag--brand { color: var(--brand); }

  .scope__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .scope__list--light { color: var(--on-dark-strong); }

  .guarantees { margin-top: 32px; }

  .todo {
    margin-top: 32px;
    border: 1px dashed var(--brand-stronger);
    border-radius: var(--r-lg);
    padding: 20px 24px;
    background: var(--brand-surface);
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-4);
  }

  @media (max-width: 1024px) {
    .scope { grid-template-columns: 1fr; gap: 20px; }
  }

  @media (max-width: 560px) {
    .scope__col { padding: 24px; }
  }
</style>
