---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Lines from '../components/Lines.astro';
import SectorCarousel from '../components/SectorCarousel.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Satellites from '../components/Satellites.astro';
import { faqPageLd } from '../data/faq';
import { getDictionary } from '../i18n';
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).campaigns;

/**
 * Habillage des aperçus de bannière : indépendant de la langue, il
 * reste dans la vue. Les textes viennent du dictionnaire, dans le même
 * ordre.
 */
const PREVIEW_STYLES = [
  { bg: '#F2C531', ink: '#1A1A1A', subInk: '#4A4A46', ctaBg: '#1A1A1A', ctaInk: '#fff', border: 'none', motif: 'rgba(26,26,26,.18)', shape: 'rings', badgeBg: 'rgba(26,26,26,.10)' },
  { bg: '#1A1A1A', ink: '#fff', subInk: '#A9A7A0', ctaBg: '#F2C531', ctaInk: '#1A1A1A', border: 'none', motif: 'rgba(242,197,49,.30)', shape: 'dots', badgeBg: 'rgba(255,255,255,.10)' },
  { bg: '#FDF3D4', ink: '#1A1A1A', subInk: '#5C5C58', ctaBg: '#1A1A1A', ctaInk: '#fff', border: '1px solid #F2C531', motif: 'rgba(242,197,49,.85)', shape: 'stripes', badgeBg: 'rgba(242,197,49,.35)' },
];

/**
 * Pictogrammes des aperçus : webinaire, recrutement, avis client. Ils
 * suivent l'ordre des textes du dictionnaire et donnent aux bannières
 * l'allure de vraies bannières plutôt que de simples encarts.
 */
const PREVIEW_ICONS = [
  '<rect x="2.6" y="3.6" width="10.8" height="9.8" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M2.6 6.6h10.8M5.6 2.2v2.6M10.4 2.2v2.6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>',
  '<circle cx="6" cy="6" r="2.3" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M2.4 13.2c.4-2.1 1.9-3.4 3.6-3.4s3.2 1.3 3.6 3.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M10.7 4.3a2 2 0 0 1 0 3.8M11.5 10c1.2.4 2 1.4 2.3 3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>',
  '<path d="M8 2.5l1.7 3.5 3.8.5-2.8 2.7.7 3.8L8 11.2l-3.4 1.8.7-3.8L2.5 6.5l3.8-.5L8 2.5Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>',
];

const previews = t.preview.items.map((item, index) => ({
  ...item,
  ...PREVIEW_STYLES[index],
  icon: PREVIEW_ICONS[index],
}));
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path={localizedPath('campaigns', locale)}
  locale={locale}
  jsonLd={[faqPageLd(t.faq.items)]}
>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} lede={t.hero.lede} />

  <section class="section section--white">
    <div class="container">
      <h2 class="sec__title">{t.uses.title}</h2>
      <p class="sec__lede"><Lines text={t.uses.lede} /></p>
      <div class="grid grid--3">
        {t.uses.items.map((u) => (
          <div class="card">
            <div class="card__tag">{u.tag}</div>
            <h3>{u.title}</h3>
            <p>{u.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectorCarousel locale={locale} />

  <section class="section section--soft">
    <div class="container split">
      <div>
        <h2 class="split__title">{t.pillars.title}</h2>
        <div class="pillars">
          {t.pillars.items.map((p) => (
            <div>
              <div class="pillars__title">{p.title}</div>
              <p class="pillars__text">{p.text}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="preview">
        <div class="preview__tag">{t.preview.tag}</div>
        <div class="preview__list">
          {previews.map((p) => (
            <div
              class="preview__banner"
              style={`background:${p.bg};color:${p.ink};border:${p.border}`}
            >
              <span
                class:list={['preview__motif', `preview__motif--${p.shape}`]}
                style={`--motif:${p.motif}`}
                aria-hidden="true"
              ></span>
              <span class="preview__badge" style={`background:${p.badgeBg}`} aria-hidden="true">
                <svg viewBox="0 0 16 16" focusable="false"><Fragment set:html={p.icon} /></svg>
              </span>
              <div class="preview__copy">
                <div class="preview__title">{p.title}</div>
                <div class="preview__sub" style={`color:${p.subInk}`}>{p.sub}</div>
              </div>
              <span class="preview__cta" style={`background:${p.ctaBg};color:${p.ctaInk}`}>{p.cta}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <FaqSection title={t.faq.title} items={t.faq.items} />

  <Satellites pillar="campaigns" locale={locale} />

  <CtaBand
    locale={locale}
    title={t.cta.title}
    text={t.cta.text}
    secondaryLabel={t.cta.secondaryLabel}
  />
</Base>

<style>
  .sec__title {
    font-size: 36px;
    line-height: 1.14;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0 0 16px;
    max-width: 760px;
  }

  .sec__lede {
    font-size: 17px;
    color: var(--sec);
    margin: 0 0 44px;
    max-width: 700px;
  }

  .card__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .split__title {
    font-size: 34px;
    line-height: 1.14;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0 0 16px;
  }

  .pillars {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 24px;
  }

  .pillars__title { font-weight: 800; font-size: 16.5px; margin-bottom: 4px; }
  .pillars__text { font-size: 15px; line-height: 1.6; color: var(--sec); margin: 0; }

  .preview {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-2xl);
    padding: 28px;
  }

  .preview__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .preview__list { display: flex; flex-direction: column; gap: 14px; }

  .preview__banner {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    min-height: 88px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 22px;
  }

  /* Habillage graphique : sans lui, une bannière ressemble à un encart. */
  .preview__motif {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .preview__motif--dots {
    background-image: radial-gradient(var(--motif) 1.6px, transparent 1.6px);
    background-size: 9px 9px;
    mask-image: linear-gradient(255deg, #000 0 30%, transparent 60%);
  }
  .preview__motif--rings {
    background-image: radial-gradient(
      circle at 92% 22%,
      transparent 0 20px,
      var(--motif) 20px 22px,
      transparent 22px 38px,
      var(--motif) 38px 40px,
      transparent 40px 58px,
      var(--motif) 58px 60px,
      transparent 60px
    );
  }
  .preview__motif--stripes {
    background-image: repeating-linear-gradient(
      -50deg,
      var(--motif) 0 3px,
      transparent 3px 13px
    );
    mask-image: linear-gradient(255deg, #000 0 24%, transparent 56%);
  }

  .preview__badge {
    position: relative;
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    border-radius: var(--r-pill);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .preview__badge svg { width: 17px; height: 17px; }

  .preview__copy { position: relative; flex: 1; }

  .preview__title { font-weight: 800; font-size: 16px; }
  .preview__sub { font-size: 12.5px; }

  .preview__cta {
    position: relative;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 13px;
    border-radius: var(--r-pill);
    white-space: nowrap;
  }

  @media (max-width: 1024px) {
    .sec__title { font-size: 29px; }
    .split { grid-template-columns: 1fr; gap: 36px; }
    .split__title { font-size: 28px; }
  }

  @media (max-width: 560px) {
    .sec__title { font-size: 25px; }
    .split__title { font-size: 24px; }
    .preview { padding: 20px; }
    .preview__banner { padding: 14px 16px; flex-direction: column; align-items: flex-start; }
  }
</style>
