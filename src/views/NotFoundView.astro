---
import Base from '../layouts/Base.astro';
import { APP_SIGNUP_URL } from '../data/nav';
import { getDictionary } from '../i18n';
import { hasBlog, localePrefix, type Locale } from '../i18n/config';
import { localizedPath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { common, notFound: t } = getDictionary(locale);

const suggestions = (['features', 'pricing', 'blog', 'contact'] as const)
  .filter((key) => key !== 'blog' || hasBlog(locale))
  .map((key) => ({ href: localizedPath(key, locale), label: t.links[key] }));
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path={`${localePrefix(locale)}/404`}
  locale={locale}
  noindex
>
  <section class="nf">
    <div class="container-narrow">
      <div class="nf__code">{t.code}</div>
      <h1 class="nf__title">{t.title}</h1>
      <p class="nf__text">{t.text}</p>

      <ul class="nf__links">
        {suggestions.map((s) => (
          <li><a href={s.href}>{s.label} →</a></li>
        ))}
      </ul>

      <div class="nf__actions">
        <a href={localizedPath('home', locale)} class="btn btn--ink btn--sm">{t.home}</a>
        <a href={APP_SIGNUP_URL} class="btn btn--brand btn--sm" target="_blank" rel="noopener">
          {common.actions.signup}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding: 96px 0 120px; background: var(--white); text-align: center; }

  .nf__code {
    font-family: var(--font-mono);
    font-size: 72px;
    font-weight: 700;
    color: var(--brand);
    line-height: 1;
    margin-bottom: 20px;
  }

  .nf__title {
    font-size: 38px;
    line-height: 1.14;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0 0 14px;
  }

  .nf__text {
    font-size: 17px;
    line-height: 1.6;
    color: var(--sec);
    margin: 0 auto 32px;
    max-width: 520px;
  }

  .nf__links {
    list-style: none;
    margin: 0 0 36px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
  }
  .nf__links a { font-size: 16px; font-weight: 700; color: var(--link-hover); text-decoration: none; }
  .nf__links a:hover { text-decoration: underline; }

  .nf__actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 560px) {
    .nf { padding: 64px 0 80px; }
    .nf__code { font-size: 56px; }
    .nf__title { font-size: 27px; }
  }
</style>
