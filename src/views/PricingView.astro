---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PricingSimulatorFull from '../components/PricingSimulatorFull.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqPageLd } from '../data/faq';
import { getDictionary } from '../i18n';
import { LOCALE_META, type Locale } from '../i18n/config';
import { localizedPath } from '../i18n/routes';
import { eur, TIERS } from '../lib/pricing';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).pricing;

/**
 * Les cartes de paliers combinent les montants de `TIERS` et les
 * libellés du dictionnaire : une seule grille de chiffres, trois jeux
 * de libellés. Le dernier palier est mis en avant.
 */
const tiers = TIERS.map((tier, index) => ({
  range: t.tiers[index],
  price: eur(tier.rate, 2, LOCALE_META[locale].intlLocale),
  highlight: index === TIERS.length - 1,
}));
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path={localizedPath('pricing', locale)}
  locale={locale}
  jsonLd={[faqPageLd(t.faq.items)]}
>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} lede={t.hero.lede} />

  <section class="pricing">
    <div class="container">
      <div class="tiers">
        {tiers.map((tier) => (
          <div class:list={['tier', tier.highlight && 'tier--highlight']}>
            <div class="tier__range">{tier.range}</div>
            <div class="tier__price">{tier.price}</div>
            <div class="tier__unit">{t.tierUnit}</div>
          </div>
        ))}
      </div>

      <PricingSimulatorFull locale={locale} />
    </div>
  </section>

  <FaqSection title={t.faq.title} items={t.faq.items} background="soft" />

  <CtaBand
    locale={locale}
    title={t.cta.title}
    text={t.cta.text}
    secondaryLabel={t.cta.secondaryLabel}
  />
</Base>

<style>
  .pricing { padding: 72px 0; background: var(--white); }

  .tiers {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    margin-bottom: 56px;
  }

  .tier {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 26px 20px;
  }

  .tier--highlight {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--white);
  }

  .tier__range {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .tier--highlight .tier__range { color: var(--brand); }

  .tier__price {
    font-family: var(--font-mono);
    font-size: 30px;
    font-weight: 700;
  }

  .tier__unit { font-size: 12.5px; color: var(--sec); margin-top: 6px; }
  .tier--highlight .tier__unit { color: var(--on-dark); }

  @media (max-width: 1024px) {
    .pricing { padding: 56px 0; }
    .tiers { grid-template-columns: repeat(3, 1fr); margin-bottom: 40px; }
  }

  @media (max-width: 620px) {
    .tiers { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  }

  @media (max-width: 400px) {
    .tiers { grid-template-columns: 1fr; }
  }
</style>
