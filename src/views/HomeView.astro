---
import Base from '../layouts/Base.astro';
import SignatureMock from '../components/SignatureMock.astro';
import Marquee from '../components/Marquee.astro';
import Testimonials from '../components/Testimonials.astro';
import Lines from '../components/Lines.astro';
import Logo from '../components/Logo.astro';
import AppTabs from '../components/AppTabs.astro';
import CampaignPlanner from '../components/CampaignPlanner.astro';
import PricingSimulator from '../components/PricingSimulator.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqPageLd } from '../data/faq';
import { APP_SIGNUP_URL } from '../data/nav';
import { getDictionary } from '../i18n';
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { common, home: t } = getDictionary(locale);
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path={localizedPath('home', locale)}
  locale={locale}
  jsonLd={[faqPageLd(t.faq.items)]}
>
  {/* ============ HERO ============ */}
  <section class="hero on-dark">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__inner">
      <div>
        <div class="hero__badge">
          <span class="hero__badge-dot"></span>
          {t.hero.badge}
        </div>
        <h1 class="hero__title">
          {t.hero.title}<br />
          <span class="hero__rotator">
            <span class="hero__rotator-track">
              {t.hero.rotating.map((word) => <span class="hero__word">{word}</span>)}
            </span>
          </span>
        </h1>
        <p class="hero__lede">{t.hero.lede}</p>
        <div class="hero__actions">
          <a href={APP_SIGNUP_URL} class="btn btn--brand btn--shadow btn--lift" target="_blank" rel="noopener">
            {common.actions.signup}
          </a>
          <a href={localizedPath('contact', locale)} class="btn btn--outline-dark">
            {common.actions.demo}
          </a>
        </div>
        {/* Badges de réassurance sécurité : bouclier + affirmation. */}
        <div class="hero__badges">
          {t.hero.badges.map((b) => (
            <span class="hero__chip">
              <svg class="hero__chip-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path
                  d="M8 1.3 2.9 3.4v4.1c0 3.1 2.1 5.9 5.1 7.2 3-1.3 5.1-4.1 5.1-7.2V3.4L8 1.3Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.3"
                />
                <path
                  d="m5.7 8 1.7 1.8 3-3.4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              {b}
            </span>
          ))}
        </div>
      </div>
      <SignatureMock />
    </div>
  </section>

  <Marquee locale={locale} />

  <Testimonials locale={locale} />

  <AppTabs locale={locale} />

  {/* ============ PROBLÉMATIQUE ============ */}
  <section class="section section--white">
    <div class="container">
      <div class="problem__head">
        <div class="eyebrow">{t.problem.eyebrow}</div>
        <h2 class="problem__title">{t.problem.title}</h2>
      </div>

      {/* Les deux colonnes s'annoncent par le logo — barré à gauche,
          en clair sur l'encre à droite — puis par leur intitulé. */}
      <div class="problem__compare">
        <div class="problem__col problem__col--without">
          <div class="problem__banner">
            <span class="problem__mark problem__mark--off">
              <Logo height={17} />
            </span>
            <span class="problem__tag">{t.problem.withoutTag}</span>
          </div>
          <div class="problem__list">
            {t.problem.without.map((item) => <div>{item}</div>)}
          </div>
        </div>
        <div class="problem__col problem__col--with on-dark">
          <div class="problem__banner">
            <span class="problem__mark problem__mark--on">
              <Logo height={17} />
            </span>
            <span class="problem__tag problem__tag--brand">{t.problem.withTag}</span>
          </div>
          <div class="problem__list problem__list--light">
            {t.problem.with.map((item) => <div>{item}</div>)}
          </div>
        </div>
      </div>

      <div class="problem__stats">
        {t.problem.stats.map((stat) => (
          <div class="problem__stat">
            <div class="problem__stat-value">{stat.value}</div>
            <div class="problem__stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============ POURQUOI SIGNALLY ============ */}
  <section class="section section--soft">
    <div class="container">
      <div class="eyebrow">{t.why.eyebrow}</div>
      <h2 class="why__title">{t.why.title}</h2>

      <div class="why__grid">
        <div class="why__hero on-dark">
          <div class="why__tag">{t.why.deploy.tag}</div>
          <h3 class="why__hero-title">{t.why.deploy.title}</h3>
          <p class="why__hero-text">{t.why.deploy.text}</p>
          <div class="why__rows" aria-hidden="true">
            {[1, 2, 3].map(() => (
              <div class="why__row">
                <span class="why__avatar"></span>
                <span class="why__line"></span>
                <span class="why__status">{t.why.deploy.rowStatus}</span>
              </div>
            ))}
          </div>
          <div class="why__metrics">
            {t.why.deploy.metrics.map((metric) => (
              <div>
                <div class="why__metric-value">{metric.value}</div>
                <div class="why__metric-label">{metric.label}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="card card--hover why__card">
          <div class="why__tag why__tag--muted">{t.why.create.tag}</div>
          <h3 class="why__card-title">{t.why.create.title}</h3>
          <p class="why__card-text">{t.why.create.text}</p>
          <a href={localizedPath('features', locale)} class="arrow-link">{t.why.create.link}</a>
        </div>

        <div class="card card--hover why__card">
          <div class="why__tag why__tag--muted">{t.why.schedule.tag}</div>
          <h3 class="why__card-title">{t.why.schedule.title}</h3>
          <p class="why__card-text">{t.why.schedule.text}</p>
          <a href={localizedPath('campaigns', locale)} class="arrow-link">{t.why.schedule.link}</a>
        </div>
      </div>
    </div>
  </section>

  {/* ============ CAMPAGNES ============ */}
  <section class="section section--white">
    <div class="container split">
      <div>
        <div class="eyebrow">{t.campaigns.eyebrow}</div>
        <h2 class="h-section"><Lines text={t.campaigns.title} /></h2>
        <p class="split__lede">{t.campaigns.lede}</p>
        <ul class="bullets">
          {t.campaigns.points.map((point) => (
            <li><span class="bullets__dot"></span>{point}</li>
          ))}
        </ul>
        <a href={localizedPath('campaigns', locale)} class="btn btn--ink btn--sm">
          {t.campaigns.cta}
        </a>
      </div>
      <CampaignPlanner locale={locale} />
    </div>
  </section>

  {/* ============ INTÉGRATIONS ============ */}
  <section class="section section--soft">
    <div class="container">
      <div class="integr__head">
        <div>
          <div class="eyebrow">{t.integrations.eyebrow}</div>
          <h2 class="h-section">{t.integrations.title}</h2>
        </div>
        <p class="integr__note">{t.integrations.note}</p>
      </div>

      <div class="grid grid--2">
        <div class="card integr__card">
          <div class="integr__tag">{t.integrations.microsoft.tag}</div>
          <h3 class="integr__title">{t.integrations.microsoft.title}</h3>
          <p class="integr__text">{t.integrations.microsoft.text}</p>
          <a href={localizedPath('microsoft', locale)} class="arrow-link">
            {t.integrations.microsoft.link}
          </a>
        </div>
        <div class="card integr__card">
          <div class="integr__tag">{t.integrations.google.tag}</div>
          <h3 class="integr__title">{t.integrations.google.title}</h3>
          <p class="integr__text">{t.integrations.google.text}</p>
          <a href={localizedPath('google', locale)} class="arrow-link">
            {t.integrations.google.link}
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ============ CONFIDENTIALITÉ ============ */}
  <section class="section section--dark on-dark">
    <div class="container">
      <div class="eyebrow eyebrow--brand">{t.privacy.eyebrow}</div>
      <h2 class="privacy__title"><Lines text={t.privacy.title} /></h2>
      <p class="privacy__lede">{t.privacy.lede}</p>

      <div class="grid grid--4 privacy__grid">
        {t.privacy.cards.map((item) => (
          <div class="privacy__card">
            <h3 class="privacy__card-title">{item.title}</h3>
            <p class="privacy__card-text">{item.text}</p>
          </div>
        ))}
      </div>

      <a href={localizedPath('security', locale)} class="btn btn--brand btn--sm privacy__cta">
        {t.privacy.cta}
      </a>
    </div>
  </section>

  {/* ============ TARIFS ============ */}
  <section class="section section--white">
    <div class="container split split--pricing">
      <div>
        <div class="eyebrow">{t.pricing.eyebrow}</div>
        <h2 class="h-section">{t.pricing.title}</h2>
        <p class="split__lede">{t.pricing.lede}</p>
        <a href={localizedPath('pricing', locale)} class="btn btn--brand btn--sm">
          {t.pricing.cta}
        </a>
      </div>
      <PricingSimulator locale={locale} />
    </div>
  </section>

  {/* ============ FAQ ============ */}
  <section class="section section--soft">
    <div class="container-narrow">
      <div class="eyebrow">{t.faq.eyebrow}</div>
      <h2 class="faq__title">{t.faq.title}</h2>
      <Faq items={t.faq.items} />
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--white);
    padding: 96px var(--gutter) 104px;
  }

  .hero__glow {
    position: absolute;
    top: -180px;
    right: -120px;
    width: 620px;
    height: 620px;
    border-radius: var(--r-pill);
    background: radial-gradient(circle, rgba(242, 197, 49, 0.22), rgba(242, 197, 49, 0) 65%);
    animation: sgGlow 9s ease-in-out infinite;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: 56px;
    align-items: center;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand);
    border: 1px solid var(--ink-3);
    border-radius: var(--r-pill);
    padding: 7px 14px;
    margin-bottom: 26px;
    animation: sgUp 0.6s ease-out both;
  }

  .hero__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--r-pill);
    background: var(--brand);
  }

  .hero__title {
    font-size: 52px;
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 800;
    margin: 0 0 22px;
    animation: sgUp 0.7s ease-out 0.06s both;
  }

  .hero__rotator {
    display: inline-block;
    height: 60px;
    overflow: hidden;
    vertical-align: bottom;
    white-space: nowrap;
  }

  .hero__rotator-track {
    display: block;
    animation: sgWord 10s cubic-bezier(0.7, 0, 0.2, 1) infinite;
  }

  .hero__word {
    display: block;
    height: 60px;
    line-height: 60px;
    color: var(--brand);
    white-space: nowrap;
  }

  .hero__lede {
    font-size: 19px;
    line-height: 1.55;
    color: var(--on-dark);
    margin: 0 0 32px;
    max-width: 480px;
    animation: sgUp 0.7s ease-out 0.12s both;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 32px;
    animation: sgUp 0.7s ease-out 0.18s both;
  }

  .hero__badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    animation: sgUp 0.7s ease-out 0.24s both;
  }

  .hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    line-height: 1.35;
    font-weight: 600;
    color: var(--on-dark);
    border: 1px solid var(--ink-3);
    border-radius: var(--r-pill);
    padding: 8px 14px 8px 11px;
  }

  .hero__chip-icon {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    color: var(--brand);
  }

  /* ---------- PROBLÉMATIQUE ---------- */
  .problem__head { max-width: 760px; margin-bottom: 48px; }

  .problem__title {
    font-size: 42px;
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 800;
    margin: 0;
  }

  .problem__compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .problem__col {
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: 32px;
    background: var(--soft);
  }

  .problem__col--with {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--white);
  }

  .problem__banner {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .problem__tag {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink);
  }
  .problem__tag--brand { color: var(--brand); }

  .problem__mark {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  /* Le logo officiel est en encre noire : il ne tient que sur fond clair.
     Sur la colonne « avec », on l'inverse pour le passer en blanc. */
  .problem__mark--on :global(.logo__img) { filter: invert(1); }

  /* Colonne « sans » : logo éteint et barré. */
  .problem__mark--off { opacity: 0.5; }
  .problem__mark--off :global(.logo__img) { filter: grayscale(1); }
  .problem__mark--off::after {
    content: '';
    position: absolute;
    left: -5px;
    right: -5px;
    top: 50%;
    border-top: 2px solid var(--ink);
    transform: rotate(-12deg);
  }

  .problem__list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 16px;
    line-height: 1.4;
    color: var(--sec);
  }
  .problem__list--light { color: var(--on-dark-strong); }

  .problem__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 32px;
  }

  .problem__stat {
    padding: 24px 24px 26px;
    border-top: 2px solid var(--brand);
  }

  .problem__stat-value {
    font-family: var(--font-mono);
    font-size: 38px;
    font-weight: 700;
  }

  .problem__stat-label { font-size: 14px; color: var(--sec); margin-top: 6px; }

  /* ---------- POURQUOI ---------- */
  .why__title {
    font-size: 40px;
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0 0 48px;
    max-width: 760px;
  }

  .why__grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    grid-template-rows: auto auto;
    gap: 20px;
  }

  .why__hero {
    grid-row: span 2;
    background: var(--ink);
    color: var(--white);
    border-radius: var(--r-2xl);
    padding: 36px;
    display: flex;
    flex-direction: column;
  }

  .why__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--brand);
    margin-bottom: 18px;
  }
  .why__tag--muted { color: var(--muted); margin-bottom: 14px; }

  /* Titre plus long depuis la relecture : 27px tient sur trois lignes. */
  .why__hero-title {
    font-size: 27px;
    font-weight: 800;
    margin: 0 0 10px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .why__hero-text {
    font-size: 16px;
    line-height: 1.55;
    color: var(--on-dark);
    margin: 0 0 28px;
    max-width: 420px;
  }

  .why__rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
  }

  .why__row {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--ink-2);
    border-radius: var(--r-md);
    padding: 12px 14px;
  }

  .why__avatar {
    width: 26px;
    height: 26px;
    border-radius: var(--r-pill);
    background: var(--ink-3);
    flex: 0 0 auto;
  }

  .why__line {
    flex: 1;
    height: 7px;
    border-radius: var(--r-pill);
    background: var(--ink-3);
  }

  .why__status {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--brand);
  }

  .why__metrics {
    margin-top: auto;
    display: flex;
    gap: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--ink-3);
  }

  .why__metric-value {
    font-family: var(--font-mono);
    font-size: 26px;
    font-weight: 700;
  }

  .why__metric-label { font-size: 13px; color: var(--on-dark-muted); margin-top: 2px; }

  .why__card { border-radius: var(--r-2xl); padding: 30px; }
  .why__card-title { font-size: 22px; font-weight: 800; margin: 0 0 8px; line-height: 1.2; }
  .why__card-text { font-size: 15px; line-height: 1.55; color: var(--sec); margin: 0 0 16px; }

  /* ---------- SPLIT ---------- */
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .split--pricing { grid-template-columns: 0.9fr 1.1fr; gap: 56px; }

  .split__lede {
    font-size: 17px;
    line-height: 1.6;
    color: var(--sec);
    margin: 16px 0 24px;
  }

  .bullets {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
  }
  .bullets li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 15.5px;
    line-height: 1.5;
  }
  .bullets__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--r-pill);
    background: var(--brand);
    margin-top: 8px;
    flex: 0 0 auto;
  }

  /* ---------- INTÉGRATIONS ---------- */
  .integr__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: 44px;
    flex-wrap: wrap;
  }
  .integr__head > div { max-width: 640px; }

  .integr__note {
    font-size: 16px;
    line-height: 1.6;
    color: var(--sec);
    margin: 0;
    max-width: 400px;
  }

  .integr__card { border-radius: var(--r-xl); padding: 32px; }
  .integr__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .integr__title { font-size: 22px; font-weight: 800; margin: 0 0 10px; }
  .integr__text { font-size: 15px; line-height: 1.6; color: var(--sec); margin: 0 0 18px; }

  /* ---------- CONFIDENTIALITÉ ---------- */
  .privacy__title {
    font-size: 38px;
    line-height: 1.14;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0 0 16px;
    max-width: 800px;
  }

  .privacy__lede {
    font-size: 17px;
    line-height: 1.6;
    color: var(--on-dark);
    margin: 0 0 44px;
    max-width: 700px;
  }

  .privacy__grid { gap: 20px; }

  .privacy__card {
    border: 1px solid var(--ink-3);
    border-radius: 16px;
    padding: 26px;
  }

  .privacy__card-title { font-size: 17px; font-weight: 800; margin: 0 0 8px; color: var(--brand); }
  .privacy__card-text { font-size: 14.5px; line-height: 1.55; color: var(--on-dark); margin: 0; }

  .privacy__cta { margin-top: 34px; }

  /* ---------- FAQ ---------- */
  .faq__title {
    font-size: 38px;
    line-height: 1.14;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0 0 40px;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 1024px) {
    .hero { padding: 72px var(--gutter) 80px; }
    .hero__inner { grid-template-columns: 1fr; gap: 44px; }
    .hero__title { font-size: 42px; }
    .hero__lede { max-width: none; }
    .problem__title { font-size: 32px; }
    .why__title { font-size: 32px; }
    .why__grid { grid-template-columns: 1fr; }
    .why__hero { grid-row: auto; }
    .split, .split--pricing { grid-template-columns: 1fr; gap: 36px; }
    .problem__stats { grid-template-columns: repeat(2, 1fr); }
    .privacy__title { font-size: 30px; }
    .faq__title { font-size: 30px; }
  }

  @media (max-width: 768px) {
    .problem__compare { grid-template-columns: 1fr; }
    .hero__title { font-size: 36px; }
    .hero__rotator, .hero__word { height: 46px; line-height: 46px; }
    /* Le keyframe sgWord décale de 60px : à 46px il faut réaligner. */
    .hero__rotator-track { animation-name: sgWordSm; }
  }

  @media (max-width: 560px) {
    .hero { padding: 56px var(--gutter) 64px; }
    .hero__title { font-size: 30px; }
    .hero__rotator, .hero__word { height: 38px; line-height: 38px; }
    .hero__rotator-track { animation-name: sgWordXs; }
    .hero__actions { flex-direction: column; align-items: stretch; }
    .problem__stats { grid-template-columns: 1fr; }
