---
/**
 * Page Contact — français.
 *
 * Rendue à la demande, contrairement au reste du site : sans JavaScript,
 * /api/contact répond par une redirection vers ?envoye=1 ou ?erreur=…,
 * et la page doit lire ses paramètres de requête — ce qu'une page
 * prérendue ne peut pas faire, son URL étant figée au build.
 */
import ContactView from '../views/ContactView.astro';

export const prerender = false;
---

<ContactView locale="fr" />
