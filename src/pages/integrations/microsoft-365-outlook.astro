---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import JourneySteps from '../../components/JourneySteps.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import Satellites from '../../components/Satellites.astro';
import { microsoftFaq, faqPageLd } from '../../data/faq';

const adminSteps = [
  {
    title: 'Connexion du tenant',
    text: "Vous autorisez Signally depuis Entra ID avec un consentement administrateur, en lecture seule sur l'annuaire.",
  },
  {
    title: "Déploiement de l'add-in",
    text: "Dans « Applications intégrées », vous déployez l'add-in à toute l'organisation ou à un groupe pilote.",
  },
  {
    title: 'Attribution des gabarits',
    text: 'Vous rattachez chaque groupe Microsoft 365 au modèle de signature qui lui correspond.',
  },
  {
    title: 'Mise à jour permanente',
    text: "Un nouvel arrivant apparaît dans l'annuaire : il reçoit sa signature sans aucune action de votre part.",
  },
];

const userSteps = [
  {
    title: 'Il ouvre Outlook',
    text: 'Rien à installer, rien à copier-coller, aucun tutoriel à suivre.',
  },
  {
    title: 'Il rédige un message',
    text: 'La signature s’insère dans le corps du message, avec ses informations et la bannière du moment.',
  },
  {
    title: 'Il envoie',
    text: "Le message part par son compte Microsoft 365. Signally n'intervient pas dans l'envoi.",
  },
  {
    title: 'Il voit ce que voit le destinataire',
    text: 'La signature est visible dans les éléments envoyés — contrairement aux règles de transport côté serveur.',
  },
];

const environments = [
  { name: 'Outlook Web', detail: 'Navigateur, tous OS' },
  { name: 'Outlook Windows', detail: 'Classique et nouveau Outlook' },
  { name: 'Outlook Mac', detail: 'Version courante' },
  { name: 'Outlook mobile', detail: 'iOS et Android' },
  { name: 'Exchange Online', detail: 'Tenants Microsoft 365' },
];

// Données structurées HowTo — demandées par le plan SEO du prototype
// pour les pages d'intégration.
const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Déployer une signature mail sur Microsoft 365 et Outlook',
  totalTime: 'PT15M',
  step: adminSteps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.title,
    text: s.text,
  })),
};
---

<Base
  title="Signature mail Microsoft 365 & Outlook — add-in de déploiement centralisé"
  description="Déployez la signature Outlook de toute l'entreprise depuis le centre d'administration Microsoft 365. Sans règle de transport Exchange, sans reroutage, en quinze minutes."
  path="/integrations/microsoft-365-outlook"
  jsonLd={[faqPageLd(microsoftFaq), howToLd]}
>
  <PageHero
    eyebrow="Add-in Microsoft 365"
    title="Signature Outlook et Microsoft 365 : déploiement centralisé, sans règle de transport."
    lede="L'add-in Signally s'installe depuis votre centre d'administration Microsoft 365 et applique la bonne signature à chaque collaborateur, dans Outlook Web, Windows, Mac et mobile. Vos e-mails partent toujours de votre tenant."
  />

  <section class="section section--white">
    <div class="container">
      <h2 class="sec__title">
        Le parcours réel, du côté de l'administrateur et du côté du collaborateur
      </h2>

      <div class="journeys">
        <JourneySteps tag="CÔTÉ ADMINISTRATEUR — 15 MINUTES" steps={adminSteps} />
        <JourneySteps tag="CÔTÉ COLLABORATEUR — 0 MINUTE" steps={userSteps} tone="dark" />
      </div>

      <div class="callout">
        <h3 class="callout__title">Pourquoi un add-in plutôt qu'une règle de transport Exchange ?</h3>
        <p class="callout__text">
          Une règle de transport ajoute la signature après l'envoi, côté serveur : le collaborateur
          ne la voit jamais, les réponses en fil s'empilent mal et le chiffrement peut poser
          problème. L'add-in insère la signature à la rédaction, dans le message que l'utilisateur a
          sous les yeux, sans reroutage de flux ni connecteur SMTP à maintenir.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <h2 class="sec__title sec__title--tight">Environnements couverts</h2>
      <div class="envs">
        {environments.map((env) => (
          <div class="env">
            <div class="env__name">{env.name}</div>
            <div class="env__detail">{env.detail}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaqSection title="Questions fréquentes — Microsoft 365 et Outlook" items={microsoftFaq} />

  <Satellites pillar="/integrations/microsoft-365-outlook" />

  <CtaBand
    title="Déployez vos signatures Outlook avec Signally"
    text="Quinze minutes depuis votre centre d'administration Microsoft 365, sans toucher à votre routage."
    secondaryLabel="Demander une démo"
  />
</Base>

<style>
  .sec__title {
    font-size: 36px;
    line-height: 1.14;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0 0 44px;
    max-width: 760px;
  }
  .sec__title--tight { font-size: 34px; margin-bottom: 32px; }

  .journeys {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .callout {
    margin-top: 32px;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 28px;
    background: var(--brand-surface);
  }

  .callout__title { font-size: 19px; font-weight: 800; margin: 0 0 10px; }
  .callout__text {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--ink-4);
    margin: 0;
    max-width: 900px;
  }

  .envs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }

  .env {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 22px;
  }

  .env__name { font-weight: 800; font-size: 15.5px; margin-bottom: 6px; }
  .env__detail { font-size: 13.5px; color: var(--sec); }

  @media (max-width: 1024px) {
    .sec__title, .sec__title--tight { font-size: 29px; margin-bottom: 32px; }
    .journeys { grid-template-columns: 1fr; gap: 20px; }
    .envs { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .sec__title, .sec__title--tight { font-size: 25px; }
    .envs { grid-template-columns: 1fr; }
    .callout { padding: 22px; }
  }
</style>
