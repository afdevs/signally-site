---
/**
 * Article de blog — français.
 *
 * Le paramètre d'URL vient de `slug` en frontmatter, pas du nom de
 * fichier : celui-ci reste la clé commune aux trois langues.
 */
import type { GetStaticPaths } from 'astro';
import ArticleView from '../../views/ArticleView.astro';
import { articlesIn } from '../../lib/blog';

export const getStaticPaths = (async () => {
  const articles = await articlesIn('fr');
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
---

<ArticleView locale="fr" article={article} />
