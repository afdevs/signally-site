---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { PILLAR_OF, articlesInCluster } from '../../data/clusters';
import { SITE, APP_SIGNUP_URL } from '../../data/nav';
import { faqPageLd, type FaqItem } from '../../data/faq';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const d = post.data;

const pillar = PILLAR_OF[d.cluster];
const sections = headings.filter((h) => h.depth === 2);

// Temps de lecture, estimé sur le nombre de mots calculé au build.
const words: number = remarkPluginFrontmatter?.words ?? 0;
const readingMinutes = Math.max(1, Math.round(words / 220));

// Liens latéraux : ceux déclarés en frontmatter d'abord, complétés par
// d'autres articles publiés de la même grappe pour tenir le minimum de
// deux imposé par les règles de maillage du plan éditorial.
const publishedSlugs = new Set(
  (await getCollection('blog', ({ data }) => !data.draft)).map((p) => p.id)
);
const siblings = articlesInCluster(d.cluster, post.id).filter((a) => publishedSlugs.has(a.slug));
const lateral = [
  ...siblings.filter((a) => d.related.includes(a.slug)),
  ...siblings.filter((a) => !d.related.includes(a.slug)),
].slice(0, 4);

const dateFmt = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' });
const displayDate = d.updatedDate ?? d.pubDate;

const faq: FaqItem[] = (d as { faq?: FaqItem[] }).faq ?? [];

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: displayDate.toISOString(),
  inLanguage: 'fr-FR',
  wordCount: words || undefined,
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: new URL(`/blog/${post.id}`, SITE.url).href,
  about: d.keyword,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
    { '@type': 'ListItem', position: 3, name: d.title },
  ],
};

const jsonLd = faq.length > 0
  ? [articleLd, breadcrumbLd, faqPageLd(faq)]
  : [articleLd, breadcrumbLd];
---

<Base
  title={d.title}
  description={d.description}
  path={`/blog/${post.id}`}
  ogType="article"
  jsonLd={jsonLd}
>
  <nav class="crumbs" aria-label="Fil d'Ariane">
    <div class="crumbs__inner">
      <a href="/">Accueil</a><span aria-hidden="true">/</span>
      <a href="/blog">Blog</a><span aria-hidden="true">/</span>
      <a href={`/blog?cat=${encodeURIComponent(d.cluster)}`}>{d.cluster}</a>
    </div>
  </nav>

  <section class="wrap">
    <div class="wrap__inner">
      <article>
        <div class="meta">
          GUIDE · MIS À JOUR EN {dateFmt.format(displayDate).toUpperCase()} · {readingMinutes} MIN DE LECTURE
        </div>

        <h1 class="title">{d.title}</h1>
        <p class="lede">{d.description}</p>

        {/* « En bref » — règle GEO du plan éditorial : un résumé factuel
            en puces, citable tel quel par un moteur génératif. */}
        <div class="brief">
          <div class="brief__tag">EN BREF</div>
          <ul class="brief__list">
            {d.summary.map((point) => <li>{point}</li>)}
          </ul>
        </div>

        <div class="prose">
          <Content />
        </div>

        {faq.length > 0 && (
          <section class="article-faq">
            <h2 class="article-faq__title">Questions fréquentes</h2>
            <Faq items={faq} compact />
          </section>
        )}

        {/* Lien de conversion unique de l'article. */}
        <div class="convert">
          <h2 class="convert__title">Déployez votre signature avec Signally</h2>
          <p class="convert__text">
            Créez votre gabarit gratuitement, puis déployez-le à toute l'organisation depuis votre
            console d'administration.
          </p>
          <a href={APP_SIGNUP_URL} class="convert__cta" target="_blank" rel="noopener">
            Créer ma signature
          </a>
        </div>
      </article>

      <aside class="side">
        {sections.length > 1 && (
          <nav class="side__box" aria-label="Sommaire">
            <div class="side__tag">SOMMAIRE</div>
            <ol class="side__toc">
              {sections.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}

        <div class="side__box side__box--soft">
          <div class="side__tag">MAILLAGE INTERNE</div>
          <div class="side__links">
            {/* Lien montant obligatoire, ancre descriptive. */}
            <a href={pillar.href}>Page pilier : {pillar.anchor} →</a>
            <a href="/securite-rgpd">Sécurité, RGPD et données en France →</a>
            <a href="/tarifs">Simulateur de coût →</a>
            <a href="/campagnes">Campagnes de bannières →</a>
          </div>
        </div>

        {lateral.length > 0 && (
          <div class="side__box">
            <div class="side__tag">DANS LA MÊME THÉMATIQUE</div>
            <div class="side__links">
              {lateral.map((a) => <a href={`/blog/${a.slug}`}>{a.title}</a>)}
            </div>
          </div>
        )}

        <div class="side__box side__box--brand">
          <div class="side__cta-title">Essayez l'éditeur</div>
          <p class="side__cta-text">
            Créez une signature complète en cinq minutes, sans carte bancaire.
          </p>
          <a href={APP_SIGNUP_URL} class="side__cta-btn" target="_blank" rel="noopener">
            Ouvrir l'éditeur
          </a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .crumbs { background: var(--white); }
  .crumbs__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 28px var(--gutter) 0;
    font-size: 13px;
    color: var(--muted);
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--link-hover); text-decoration: underline; }

  .wrap { padding: 32px 0 0; background: var(--white); }
  .wrap__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter) 88px;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 56px;
    align-items: start;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--link-hover);
    margin-bottom: 16px;
  }

  .title {
    font-size: 44px;
    line-height: 1.12;
    letter-spacing: -0.022em;
    font-weight: 800;
    margin: 0 0 20px;
  }

  .lede {
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-4);
    margin: 0 0 32px;
  }

  /* ---- En bref ---- */
  .brief {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 26px;
    background: var(--soft);
    margin-bottom: 36px;
  }

  .brief__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .brief__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding-left: 20px;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* ---- Corps ---- */
  .prose { font-size: 17px; line-height: 1.72; color: var(--ink-2); }

  .prose :global(h2) {
    font-size: 30px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 800;
    color: var(--ink);
    margin: 40px 0 14px;
    scroll-margin-top: calc(var(--header-h) + 20px);
  }

  .prose :global(h3) {
    font-size: 21px;
    font-weight: 800;
    color: var(--ink);
    margin: 30px 0 10px;
  }

  .prose :global(p) { margin: 0 0 18px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 24px; padding-left: 24px; }
  .prose :global(li) { margin-bottom: 9px; line-height: 1.6; }

  .prose :global(a) {
    color: var(--link-hover);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(strong) { color: var(--ink); font-weight: 700; }

  /* Encadré « Bon à savoir » : > blockquote en markdown. */
  .prose :global(blockquote) {
    border: 1px solid var(--brand);
    background: var(--brand-surface);
    border-radius: 16px;
    padding: 22px 26px;
    margin: 0 0 30px;
  }
  .prose :global(blockquote p) { margin: 0; font-size: 16.5px; line-height: 1.65; color: var(--ink-2); }
  .prose :global(blockquote p + p) { margin-top: 10px; }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 30px;
    font-size: 15px;
  }
  .prose :global(th), .prose :global(td) {
    border: 1px solid var(--line);
    padding: 10px 14px;
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) { background: var(--soft); font-weight: 700; }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--soft);
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* ---- FAQ ---- */
  .article-faq { margin: 40px 0 0; }
  .article-faq__title {
    font-size: 30px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0 0 14px;
  }

  /* ---- Conversion ---- */
  .convert {
    border-radius: var(--r-xl);
    padding: 30px;
    background: var(--ink);
    color: var(--white);
    margin-top: 40px;
  }
  .convert__title { font-size: 22px; font-weight: 800; margin: 0 0 8px; }
  .convert__text {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--on-dark);
    margin: 0 0 20px;
  }
  .convert__cta {
    font-size: 15px;
    font-weight: 700;
    padding: 13px 22px;
    border-radius: 11px;
    background: var(--brand);
    color: var(--ink);
    text-decoration: none;
    display: inline-block;
    transition: background 0.15s ease;
  }
  .convert__cta:hover { background: var(--brand-strong); color: var(--ink); text-decoration: none; }

  /* ---- Colonne latérale ---- */
  .side {
    position: sticky;
    top: calc(var(--header-h) + 28px);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .side__box {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 22px;
  }
  .side__box--soft { background: var(--soft); }
  .side__box--brand { border-color: var(--brand); background: var(--brand-surface); }

  .side__tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .side__toc {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    line-height: 1.4;
  }
  .side__toc a { color: var(--ink-2); font-weight: 600; text-decoration: none; }
  .side__toc a:hover { color: var(--link-hover); text-decoration: underline; }

  .side__links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 14px;
    line-height: 1.4;
  }
  .side__links a { color: var(--ink-2); font-weight: 600; text-decoration: none; }
  .side__links a:hover { color: var(--link-hover); text-decoration: underline; }

  .side__cta-title { font-weight: 800; font-size: 16px; margin-bottom: 8px; }
  .side__cta-text {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--sec);
    margin: 0 0 14px;
  }
  .side__cta-btn {
    font-size: 13.5px;
    font-weight: 700;
    padding: 11px 16px;
    border-radius: var(--r-md);
    background: var(--ink);
    color: var(--white);
    text-decoration: none;
    display: inline-block;
    transition: background 0.15s ease;
  }
  .side__cta-btn:hover { background: var(--ink-2); color: var(--white); text-decoration: none; }

  @media (max-width: 1024px) {
    .wrap__inner { grid-template-columns: 1fr; gap: 40px; }
    /* Le sommaire collant n'a plus de sens en pleine largeur. */
    .side { position: static; }
    .title { font-size: 34px; }
    .lede { font-size: 17.5px; }
  }

  @media (max-width: 700px) {
    /* Un tableau markdown à quatre colonnes déborde sous ~700px.
       On le rend défilant plutôt que de laisser la page déborder. */
    .prose :global(table) {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
      -webkit-overflow-scrolling: touch;
    }
    .prose :global(td), .prose :global(th) { white-space: normal; min-width: 140px; }
  }

  @media (max-width: 560px) {
    .title { font-size: 28px; }
    .lede { font-size: 16.5px; }
    .prose { font-size: 16.5px; }
    .prose :global(h2) { font-size: 24px; margin-top: 34px; }
    .article-faq__title { font-size: 24px; }
    .brief { padding: 20px; }
    .convert { padding: 24px; }
  }
</style>
