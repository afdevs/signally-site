{
  "name": "signally-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Site marketing Signally — gestion de signatures mail et campagnes de bannières",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "start:prod": "NODE_ENV=production HOST=127.0.0.1 node ./dist/server/entry.mjs",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:mail": "node scripts/check-mail.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.6",
    "@astrojs/node": "^9.2.2",
    "@astrojs/sitemap": "^3.4.0",
    "@fontsource-variable/manrope": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "astro": "^5.8.0",
    "dotenv": "^17.4.2",
    "nodemailer": "^6.10.1",
    "zod": "^3.25.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.8.3"
  }
}
